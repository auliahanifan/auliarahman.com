  .pthumb .i { position: relative; z-index: 1; width: 36%; height: auto; aspect-ratio: 1; stroke-width: 1.4; filter: drop-shadow(0 6px 10px rgba(0,0,0,.25)); transition: transform .5s cubic-bezier(.2,1.5,.4,1); }
  .pthumb em { position: absolute; z-index: 2; top: 8px; left: 8px; padding: 3px 8px; border-radius: 999px; background: rgba(255,255,255,.92); color: var(--ink-800); font: normal 600 10.5px var(--font-body); box-shadow: 0 2px 6px rgba(0,0,0,.08); }
