  .pthumb { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 12px; background: radial-gradient(130% 100% at 22% 12%, var(--g1), var(--g2)); color: #fff; }
  .pthumb::before { content: ''; position: absolute; width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,255,255,.45), transparent); transform: translate(10%, 18%); }
