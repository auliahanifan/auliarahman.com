  /* toast */
  .toasts { position: absolute; left: 50%; bottom: 22px; z-index: 40; display: flex; flex-direction: column; align-items: center; gap: 8px; transform: translateX(-50%); pointer-events: none; width: max-content; max-width: calc(100% - 32px); }
  .toast { display: flex; align-items: center; gap: 10px; padding: 11px 18px 11px 14px; border-radius: 999px; background: rgba(11,13,18,.94); color: #fff; font-weight: 500; box-shadow: 0 16px 40px -12px rgba(0,0,0,.55), inset 0 0 0 1px rgba(255,255,255,.08); animation: toast-in .5s cubic-bezier(.2,1.4,.4,1) both; max-width: 100%; }
  .toast span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
