---
// Empat contoh aplikasi yang bisa diklik. Data fiktif, semuanya berjalan di browser.
// Logika tiap aplikasi ada di ./demo/*.ts, gaya ada di bawah (global, berawalan .demo).
const apps = [
  {
    id: 'pos', name: 'Kasir', hint: 'Kedai kopi', icon: '<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/>', url: 'kedailereng.app/kasir',
    prompt: 'Buatkan aplikasi kasir untuk kedai kopi saya. Ada daftar menu per kategori, pilihan ukuran dan gula untuk minuman, diskon member 10%, pajak 10%, bayar tunai atau QRIS dengan hitungan kembalian, lalu struk setelah bayar.',
  },
  {
    id: 'dash', name: 'Dashboard', hint: 'Penjualan dan stok', icon: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 6-6"/>', url: 'kedailereng.app/ringkasan',
    prompt: 'Saya ingin melihat kondisi kedai dalam satu layar: omzet, jumlah transaksi, grafik dibanding periode sebelumnya, metode bayar, jam paling ramai, menu terlaris, transaksi terbaru, dan bahan yang hampir habis.',
  },
  {
    id: 'book', name: 'Booking', hint: 'Barbershop', icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>', url: 'cukurkidul.app/jadwal',
    prompt: 'Buatkan jadwal booking untuk barbershop dengan tiga kapster. Tampilkan per kolom kapster dari jam 10 sampai 20, bisa klik jam kosong untuk booking baru, dan ubah status pelanggan dari terjadwal, sedang dilayani, sampai selesai.',
  },
  {
    id: 'crm', name: 'Pelanggan', hint: 'Katering', icon: '<rect x="3" y="3" width="5" height="18" rx="1.5"/><rect x="10" y="3" width="5" height="12" rx="1.5"/><rect x="17" y="3" width="4" height="8" rx="1.5"/>', url: 'dapurratna.app/pipeline',
    prompt: 'Usaha katering saya sering lupa follow-up calon pelanggan. Buatkan papan kanban dengan status baru, follow-up, negosiasi, dan deal yang bisa digeser, plus template pesan WhatsApp yang tinggal disalin.',
  },
];
---

<div class="demo" data-demo data-active="pos">
  <div class="demo-tabs" role="tablist" aria-label="Contoh aplikasi">
    <span class="tab-ind" aria-hidden="true"></span>
    {apps.map((a, i) => (
      <button type="button" role="tab" id={`tab-${a.id}`} aria-controls={`app-${a.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={a.id} data-url={a.url} data-prompt={a.prompt}>
        <span class="tab-ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={a.icon} /></span>
        <span class="tab-tx"><strong>{a.name}</strong><span>{a.hint}</span></span>
      </button>
    ))}
  </div>
  <div class="stage">
    <div class="win">
      <div class="win-bar" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="wb-nav"><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></span>
        <span class="url"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span class="url-t">{apps[0].url}</span></span>
        <span class="wb-end"><svg viewBox="0 0 24 24"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="m16 6-4-4-4 4M12 2v13"/></svg></span>
      </div>
      {apps.map((a, i) => (
        <div class="app" role="tabpanel" id={`app-${a.id}`} aria-labelledby={`tab-${a.id}`} data-app={a.id} hidden={i !== 0}></div>
      ))}
    </div>
  </div>
  <div class="prompt">
    <span class="prompt-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3c.5 4 2 5.5 6 6-4 .5-5.5 2-6 6-.5-4-2-5.5-6-6 4-.5 5.5-2 6-6z"/></svg></span>
    <div><span class="mono">Contoh permintaan ke AI</span><p class="prompt-t">“{apps[0].prompt}”</p></div>
  </div>
</div>

<script>
  import { initPos } from './demo/pos';
  import { initDash } from './demo/dash';
  import { initBook } from './demo/book';
  import { initCrm } from './demo/crm';
  import { closeSheet } from './demo/shared';

  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    const panel = (id: string) => root.querySelector<HTMLElement>(`#app-${id}`)!;
    const apps: Record<string, { show(): void }> = {
      pos: initPos(panel('pos')), dash: initDash(panel('dash')), book: initBook(panel('book')), crm: initCrm(panel('crm')),
    };
    const list = root.querySelector<HTMLElement>('.demo-tabs')!;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const ind = list.querySelector<HTMLElement>('.tab-ind')!;
    const url = root.querySelector<HTMLElement>('.url-t')!;
    const prompt = root.querySelector<HTMLElement>('.prompt-t')!;
    let seen = false;

    const place = (t: HTMLElement, animate = true) => {
      ind.classList.toggle('still', !animate);
      ind.style.width = `${t.offsetWidth}px`;
      ind.style.height = `${t.offsetHeight}px`;
      ind.style.transform = `translate(${t.offsetLeft}px, ${t.offsetTop}px)`;
    };
    const replay = (e: HTMLElement, cls: string) => { e.classList.remove(cls); void e.offsetWidth; e.classList.add(cls); };

    const select = (t: HTMLButtonElement) => {
      const id = t.dataset.tab!;
      if (root.dataset.active === id && seen) return;
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const p = panel(x.dataset.tab!);
        if (!on) closeSheet(p);
        p.hidden = !on;
      });
      root.dataset.active = id;
      place(t);
      url.textContent = t.dataset.url ?? '';
      prompt.textContent = `“${t.dataset.prompt}”`;
      replay(prompt, 'swap');
      replay(panel(id), 'enter');
      seen = true;
      apps[id].show();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const n = tabs[(i + d + tabs.length) % tabs.length];
        n.focus();
        select(n);
      });
    });
    new ResizeObserver(() => place(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!, false)).observe(list);
    // Animasi pembuka diputar saat jendela demo pertama kali terlihat.
    new IntersectionObserver(([e], o) => {
      if (!e.isIntersecting) return;
      o.disconnect();
      if (!seen) { seen = true; replay(panel(root.dataset.active!), 'enter'); apps[root.dataset.active!].show(); }
    }, { threshold: 0.2 }).observe(root.querySelector('.win')!);
  }
</script>

<style is:global>
  /* Konten demo digambar lewat JS, jadi gayanya global dengan awalan .demo. */
  @property --glow { syntax: '<color>'; inherits: true; initial-value: #FFB224; }
  .demo { --glow: #FFB224; position: relative; z-index: 1; display: flex; flex-direction: column; gap: 20px; min-width: 0; transition: --glow .8s ease; }
  .demo[data-active='dash'] { --glow: #3A5BFF; }
  .demo[data-active='book'] { --glow: #8B5CF6; }
  .demo[data-active='crm'] { --glow: #25B892; }
  /* Warna aurora di section halaman ikut aplikasi yang aktif. */
  .demo-band:has(.demo[data-active='dash']) { --a1: #3A5BFF; --a2: #2BB3FF; }
  .demo-band:has(.demo[data-active='book']) { --a1: #8B5CF6; --a2: #FF6B47; }
  .demo-band:has(.demo[data-active='crm']) { --a1: #25B892; --a2: #2BB3FF; }
  .demo [hidden] { display: none !important; }
  .demo .i { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- tab ---------- */
  .demo-tabs { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; padding: 6px; border-radius: 20px; background: rgba(255,255,255,.06); box-shadow: inset 0 0 0 1px rgba(255,255,255,.1); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .tab-ind { position: absolute; left: 0; top: 0; border-radius: 15px; background: #fff; box-shadow: 0 10px 30px -8px rgba(0,0,0,.5), 0 0 40px -10px var(--glow); transition: transform .55s cubic-bezier(.3,1.25,.4,1), width .55s cubic-bezier(.3,1.25,.4,1), height .55s; pointer-events: none; }
  .tab-ind.still { transition: none; }
  .demo-tabs [role='tab'] { position: relative; z-index: 1; display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 10px 14px; border: 0; border-radius: 15px; background: none; color: rgba(255,255,255,.72); font: inherit; text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: color .35s; }
  .demo-tabs [role='tab']:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .demo-tabs [role='tab'][aria-selected='false']:hover { color: #fff; } .demo-tabs [role='tab'][aria-selected='false']:hover .tab-ic { background: rgba(255,255,255,.14); } }
  .tab-ic { width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 11px; background: rgba(255,255,255,.08); transition: background .35s, color .35s, transform .35s cubic-bezier(.3,1.5,.4,1); }
  .tab-ic svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tab-tx { display: flex; flex-direction: column; min-width: 0; }
  .tab-tx strong { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .tab-tx span { font-size: 12.5px; opacity: .72; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .demo-tabs [aria-selected='true'] { color: var(--ink-900); }
  .demo-tabs [aria-selected='true'] .tab-ic { background: var(--glow); color: #fff; transform: rotate(-6deg) scale(1.05); }

  /* ---------- jendela ---------- */
  .stage { position: relative; }
  .stage::before { content: ''; position: absolute; inset: 10% 8% -6%; border-radius: 50%; background: radial-gradient(closest-side, var(--glow), transparent); opacity: .45; filter: blur(50px); pointer-events: none; }
  .win { position: relative; border-radius: 22px; background: #fff; overflow: hidden; box-shadow: 0 0 0 1px rgba(255,255,255,.14), 0 40px 90px -30px rgba(0,0,0,.75), 0 0 0 8px rgba(255,255,255,.04); }
  .win-bar { display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: 14px; padding: 10px 16px; background: linear-gradient(#FBFBFC, #F1F3F6); border-bottom: 1px solid var(--abu-200); }
  .win-bar svg { width: 16px; height: 16px; fill: none; stroke: var(--ink-400); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .win-bar .dots { display: flex; gap: 7px; }
  .win-bar .dots i { width: 11px; height: 11px; border-radius: 50%; background: #FF5F57; box-shadow: inset 0 0 0 .5px rgba(0,0,0,.12); }
  .win-bar .dots i:nth-child(2) { background: #FEBC2E; }
  .win-bar .dots i:nth-child(3) { background: #28C840; }
  .wb-nav, .wb-end { display: flex; gap: 6px; }
  .win-bar .url { justify-self: center; width: min(100%, 380px); min-width: 0; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 6px 12px; border-radius: 9px; background: #fff; box-shadow: 0 0 0 1px var(--abu-200), 0 1px 2px rgba(11,13,18,.04); font: 12px var(--font-mono); color: var(--ink-600); }
  .win-bar .url svg { width: 12px; height: 12px; stroke: var(--mint-600); }
  .url-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .app { --acc: var(--amber-500); --acc-50: var(--amber-50); --acc-100: var(--amber-100); --acc-800: var(--amber-800); --acc-ink: var(--ink-900);
    height: 740px; background: #fff; color: var(--ink-800); font-size: 13.5px; line-height: 1.45; letter-spacing: -0.005em; text-align: left; }
  .app[hidden] { display: none; }
  .app[data-app='dash'] { --acc: var(--kobalt-500); --acc-50: var(--kobalt-50); --acc-100: var(--kobalt-100); --acc-800: var(--kobalt-700); --acc-ink: #fff; }
  .app[data-app='book'] { --acc: var(--ungu-500); --acc-50: var(--ungu-50); --acc-100: var(--ungu-100); --acc-800: var(--ungu-800); --acc-ink: #fff; }
  .app[data-app='crm'] { --acc: var(--mint-500); --acc-50: var(--mint-50); --acc-100: var(--mint-100); --acc-800: var(--mint-800); --acc-ink: #fff; }
  .app.enter .shell { animation: app-in .6s cubic-bezier(.2,.8,.2,1); }
  @keyframes app-in { from { opacity: 0; transform: translateY(14px) scale(.985); filter: blur(8px); } }
  .app button { font: inherit; color: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .app button:disabled { cursor: not-allowed; }
  .app :focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }
  .app input { font: inherit; color: var(--ink-900); }
  .app ul, .app ol { list-style: none; }

  /* warna per nada */
  .demo .t-ungu { --t: var(--ungu-500); --t-50: var(--ungu-50); --t-100: var(--ungu-100); --t-800: var(--ungu-800); --t-ink: #fff; }
  .demo .t-langit { --t: var(--langit-500); --t-50: var(--langit-50); --t-100: var(--langit-100); --t-800: var(--langit-800); --t-ink: #fff; }
  .demo .t-mint { --t: var(--mint-500); --t-50: var(--mint-50); --t-100: var(--mint-100); --t-800: var(--mint-800); --t-ink: #fff; }
  .demo .t-amber { --t: var(--amber-500); --t-50: var(--amber-50); --t-100: var(--amber-100); --t-800: var(--amber-800); --t-ink: var(--ink-900); }
  .demo .t-koral { --t: var(--koral-500); --t-50: var(--koral-50); --t-100: var(--koral-100); --t-800: var(--koral-800); --t-ink: #fff; }
  .demo .t-acc { --t: var(--acc); --t-50: var(--acc-50); --t-100: var(--acc-100); --t-800: var(--acc-800); }

  /* ---------- kerangka aplikasi ---------- */
  .shell { display: grid; grid-template-columns: 68px minmax(0, 1fr); height: 100%; }
  .rail { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 16px 0; background: #FAFAFB; border-right: 1px solid var(--abu-100); }
  .rail-logo { width: 40px; height: 40px; margin-bottom: 12px; display: grid; place-items: center; border-radius: 12px; background: linear-gradient(140deg, var(--acc), color-mix(in oklab, var(--acc), #000 25%)); color: var(--acc-ink); font: 600 12px var(--font-mono); box-shadow: 0 8px 18px -6px var(--acc), inset 0 1px 0 rgba(255,255,255,.35); }
  .rail-i { position: relative; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; color: var(--ink-400); }
  .rail-i.on { background: var(--acc-50); color: var(--acc-800); }
  .rail-i.on::before { content: ''; position: absolute; left: -13px; top: 10px; bottom: 10px; width: 3px; border-radius: 0 3px 3px 0; background: var(--acc); }
  .rail-sp { flex: 1; }
  .main { position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; }
  .topbar { display: flex; align-items: center; gap: 12px; padding: 12px 20px; border-bottom: 1px solid var(--abu-100); }
  .tb-logo { display: none; width: 34px; height: 34px; flex: none; place-items: center; border-radius: 10px; background: var(--acc); color: var(--acc-ink); font: 600 11px var(--font-mono); }
  .tb-title { display: flex; flex-direction: column; min-width: 0; margin-right: auto; }
  .tb-crumb { font-size: 12px; color: var(--ink-500); }
  .tb-title strong { font-size: 16px; font-weight: 600; letter-spacing: -0.02em; color: var(--ink-900); white-space: nowrap; }
  .tb-search, .search { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 10px 0 12px; border-radius: 11px; background: var(--abu-50); box-shadow: inset 0 0 0 1px var(--abu-200); color: var(--ink-400); transition: box-shadow .2s, background .2s; }
  .tb-search { width: min(280px, 34%); }
  .tb-search:focus-within, .search:focus-within { background: #fff; box-shadow: inset 0 0 0 1.5px var(--acc), 0 0 0 4px var(--acc-50); }
  .tb-search input, .search input { flex: 1; min-width: 0; height: 100%; border: 0; background: none; outline: none; font-size: 13.5px; }
  .tb-search input::-webkit-search-cancel-button, .search input::-webkit-search-cancel-button { display: none; }
  .tb-search kbd { font: 11px var(--font-mono); padding: 2px 6px; border-radius: 6px; background: #fff; box-shadow: inset 0 0 0 1px var(--abu-200); color: var(--ink-500); }
  .tb-search .i, .search .i { width: 17px; height: 17px; }
  .tb-icon { position: relative; width: 38px; height: 38px; display: grid; place-items: center; border: 0; border-radius: 11px; background: none; color: var(--ink-600); transition: background .2s; }
  .tb-icon:hover { background: var(--abu-100); }
  .tb-icon .dot { position: absolute; top: 9px; right: 10px; width: 8px; height: 8px; border-radius: 50%; background: var(--koral-500); box-shadow: 0 0 0 2px #fff; animation: dot-pulse 2.4s ease-in-out infinite; }
  @keyframes dot-pulse { 50% { transform: scale(1.25); } }
  .tb-user { display: flex; align-items: center; gap: 10px; padding-left: 12px; border-left: 1px solid var(--abu-200); }
  .tb-name { display: flex; flex-direction: column; font-size: 13px; font-weight: 600; color: var(--ink-900); line-height: 1.25; }
  .tb-name em { font-style: normal; font-weight: 400; font-size: 11.5px; color: var(--ink-500); }
  .content { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-width: thin; container: app / inline-size; }

  /* ---------- komponen umum ---------- */
  .av { width: 34px; height: 34px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--t-100, var(--abu-100)); color: var(--t-800, var(--ink-700)); font-weight: 600; font-size: 12px; }
  .h { font-size: 19px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.25; color: var(--ink-900); }
  .demo .sub { font-size: 12.5px; color: var(--ink-500); }
  .eyebrow-s { display: block; font: 500 11px var(--font-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-500); margin-bottom: 2px; }
  .lbl { display: block; font-size: 11.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-500); margin-bottom: 8px; }
  .app .card { padding: 16px; border-radius: 16px; background: #fff; box-shadow: 0 0 0 1px var(--abu-200), 0 1px 2px rgba(11,13,18,.04); min-width: 0; }
  .card-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .card-h strong { display: block; font-size: 14.5px; font-weight: 600; letter-spacing: -0.01em; color: var(--ink-900); }
  .demo .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; padding: 8px 16px; border: 0; border-radius: 12px; font-weight: 600; font-size: 13.5px; letter-spacing: -0.01em; white-space: nowrap; transition: transform .18s cubic-bezier(.3,1.5,.5,1), background-color .2s, box-shadow .2s, color .2s; }
  .demo .btn:active:not(:disabled) { transform: scale(.96); }
  .demo .btn .i { width: 18px; height: 18px; }
  .btn-pri { background: var(--ink-900); color: #fff !important; box-shadow: inset 0 1px 0 rgba(255,255,255,.14), 0 8px 18px -8px rgba(11,13,18,.6); }
  .btn-pri:disabled { background: var(--abu-300); box-shadow: none; }
  .btn-ghost { background: #fff; color: var(--ink-800); box-shadow: inset 0 0 0 1px var(--abu-300); }
  .btn-ghost.danger { color: var(--koral-800); }
  .btn-wa { background: #25D366; color: #052E16 !important; box-shadow: 0 8px 18px -8px #25D366; }
  .demo .btn-lg { min-height: 52px; font-size: 15px; border-radius: 14px; }
  .demo .btn-sm { min-height: 34px; padding: 6px 12px; font-size: 12.5px; border-radius: 10px; }
  .btn-lg .sep { width: 1px; height: 18px; background: rgba(255,255,255,.25); }
  .demo .btn.ok, .demo .btn.ok:disabled { background: var(--mint-500); color: #fff; box-shadow: none; }
  .demo .wide { width: 100%; }
  .grow { flex: 1; }
  @media (hover: hover) and (pointer: fine) {
    .btn-pri:hover:not(:disabled) { background: var(--ink-700); }
    .btn-ghost:hover:not(:disabled) { background: var(--abu-50); }
  }
  .spin { width: 14px; height: 14px; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .icon-btn { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border: 0; border-radius: 11px; background: var(--abu-100); color: var(--ink-600); transition: background .2s, transform .2s; }
  .icon-btn:hover:not(:disabled) { background: var(--abu-200); }
  .icon-btn:disabled { opacity: .4; }
  .icon-btn .i { width: 18px; height: 18px; }
  .seg { display: inline-flex; gap: 2px; padding: 4px; border-radius: 12px; background: var(--abu-100); }
  .seg button { flex: 1; min-height: 34px; padding: 6px 14px; border: 0; border-radius: 9px; background: none; font-weight: 500; color: var(--ink-600); white-space: nowrap; transition: background .25s, color .25s, box-shadow .25s; }
