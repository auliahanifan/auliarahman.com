  .toast.out { animation: toast-out .3s ease forwards; }
  @keyframes toast-in { from { opacity: 0; transform: translateY(16px) scale(.9); } }
  @keyframes toast-out { to { opacity: 0; transform: translateY(8px) scale(.96); } }

  /* sheet dan drawer */
  .sheet-wrap { position: absolute; inset: 0; z-index: 30; display: none; }
  .sheet-wrap.open, .sheet-wrap.closing { display: block; }
  .sheet-bg { position: absolute; inset: 0; background: rgba(11,13,18,.32); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); animation: fade-in .3s both; }
  .closing .sheet-bg { animation: fade-out .28s forwards; }
  .sheet { position: absolute; left: 50%; top: 50%; width: min(460px, calc(100% - 32px)); max-height: calc(100% - 32px); overflow: auto; overscroll-behavior: contain; padding: 22px; border-radius: 22px; background: #fff; box-shadow: 0 50px 100px -30px rgba(11,13,18,.5), 0 0 0 1px rgba(11,13,18,.06); transform: translate(-50%, -50%); animation: sheet-in .5s cubic-bezier(.2,1.2,.3,1) both; outline: none; }
  .closing .sheet { animation: sheet-out .25s ease forwards; }
  @keyframes sheet-in { from { opacity: 0; transform: translate(-50%, -44%) scale(.94); } }
  @keyframes sheet-out { to { opacity: 0; transform: translate(-50%, -48%) scale(.97); } }
  .drawer .sheet { left: auto; right: 12px; top: 12px; bottom: 12px; width: min(440px, calc(100% - 24px)); max-height: none; transform: none; padding-bottom: 0; animation: drawer-in .55s cubic-bezier(.2,1,.3,1) both; }
  .drawer.closing .sheet { animation: drawer-out .3s ease forwards; }
  @keyframes drawer-in { from { transform: translateX(110%); } }
  @keyframes drawer-out { to { transform: translateX(110%); } }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes fade-out { to { opacity: 0; } }
