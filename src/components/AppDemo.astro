  .bkb { position: absolute; left: 4px; right: 4px; display: flex; flex-direction: column; gap: 1px; padding: 6px 8px 6px 10px; overflow: hidden; border: 0; border-radius: 10px; background: var(--t-50); color: var(--t-800); text-align: left; font-size: 12px; line-height: 1.25; box-shadow: inset 3px 0 0 var(--t), 0 1px 2px rgba(11,13,18,.06); transition: transform .25s cubic-bezier(.3,1.5,.5,1), box-shadow .25s; cursor: pointer; }
