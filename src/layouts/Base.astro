---
interface Props {
  title: string;
  description: string;
}
import '../styles/tokens.css';
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#F4F5F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0D12" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const saved = localStorage.getItem('ah-theme');
      const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
      if ((saved ?? (prefersDark ? 'dark' : 'light')) === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body>
    <button class="theme-toggle" aria-label="ganti tema">
      <svg class="moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <main class="wrap">
      <slot />
    </main>
    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        if (next === 'dark') root.setAttribute('data-theme', 'dark');
        else root.removeAttribute('data-theme');
        localStorage.setItem('ah-theme', next);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: var(--bg-page);
    --card: var(--surface-card);
    --hairline: var(--shadow-hairline);
    --accent: var(--kobalt-600);
    --accent-solid: var(--kobalt-500);
    --accent-solid-hover: var(--kobalt-600);
    --tag-bg: var(--kobalt-50);
    --tag-fg: var(--kobalt-700);
    --lede-hi: var(--kobalt-100);
    --rule: var(--border-1);
    --ink: var(--fg-1);
    --ink-2: var(--fg-2);
    --ink-3: var(--fg-3);
    --ink-4: var(--ink-400);
    --mono: var(--font-mono);
    --sans: var(--font-body);
  }
  html[data-theme='dark'] {
    --bg: var(--ink-900);
    --card: var(--ink-800);
    --hairline: inset 0 0 0 1px var(--ink-700);
    --accent: var(--kobalt-300);
    --tag-bg: rgba(58, 91, 255, 0.18);
    --tag-fg: var(--kobalt-200);
    --lede-hi: rgba(58, 91, 255, 0.35);
    --rule: var(--ink-700);
    --ink: var(--abu-50);
    --ink-2: var(--abu-300);
    --ink-3: var(--ink-400);
    --ink-4: var(--ink-500);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; overflow-x: hidden; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: var(--lh-normal);
    letter-spacing: var(--ls-body);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--kobalt-100); color: var(--ink-900); }
  :focus-visible { outline: none; box-shadow: var(--shadow-focus); border-radius: var(--radius-2); }

  .wrap { max-width: var(--prose-max); margin: 0 auto; padding: 5rem 1.6rem; }

  .theme-toggle {
    position: fixed; top: 1.2rem; right: 1.2rem;
    width: 34px; height: 34px; border-radius: var(--radius-pill);
    border: 0; box-shadow: var(--hairline); background: var(--card); color: var(--ink-3);
    display: grid; place-items: center; cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover { color: var(--ink); }
  .theme-toggle .sun { display: none; }
  html[data-theme='dark'] .theme-toggle .moon { display: none; }
  html[data-theme='dark'] .theme-toggle .sun { display: block; }

  /* header */
  .name-row { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  h1 { font-family: var(--font-display); font-size: var(--fs-28); font-weight: 600; letter-spacing: var(--ls-heading); line-height: var(--lh-snug); }
  .role { color: var(--ink-2); }
  .role a, .prose a { color: var(--accent); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--dur-fast) var(--ease-out); }
  .role a:hover, .prose a:hover { text-decoration-color: currentColor; }

  /* lede */
  .lede {
    font-size: 18px; margin: 2rem 0 3rem; max-width: 52ch;
    padding-top: 1.6rem; border-top: 1px solid var(--rule);
  }
  .lede em {
    font-style: normal; padding: 0 2px; border-radius: 2px;
    background: linear-gradient(180deg, transparent 58%, var(--lede-hi) 58%);
  }

  /* sections */
  section { margin-bottom: 2.8rem; }
  .label {
    font-family: var(--mono); font-size: var(--fs-12); color: var(--ink-3);
    margin-bottom: 0.9rem;
  }
  .row {
    display: block; padding: 0.85rem 0; border-top: 1px solid var(--rule);
  }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .row-head { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .row-title { font-weight: 600; font-size: 16px; letter-spacing: var(--ls-heading); transition: color var(--dur-fast) var(--ease-out); }
  .row-tag {
    font-family: var(--mono); font-size: var(--fs-11); font-weight: 500;
    background: var(--tag-bg); color: var(--tag-fg);
    padding: 1px 8px; border-radius: var(--radius-pill);
  }
  .row-date { font-family: var(--mono); font-size: var(--fs-12); color: var(--ink-3); margin-left: auto; white-space: nowrap; }
  .row-desc { color: var(--ink-2); font-size: 15px; margin-top: 0.2rem; }
  a.row:hover .row-title { color: var(--accent); }

  /* currently */
  .now {
    background: var(--card); box-shadow: var(--hairline); border-radius: var(--radius-3); padding: 1rem 1.2rem;
    font-family: var(--mono); font-size: 13px; line-height: 1.8;
    display: grid; grid-template-columns: max-content 1fr; column-gap: 1.4rem;
  }
  .now dt { color: var(--ink-3); }
  .now dd { color: var(--ink); }

  /* contact */
  .contact { background: var(--card); box-shadow: var(--hairline); border-radius: var(--radius-3); padding: 1.4rem; }
  .contact h2 { font-family: var(--font-display); font-size: var(--fs-22); font-weight: 600; letter-spacing: var(--ls-heading); line-height: var(--lh-snug); margin-bottom: 0.6rem; }
  .contact p { color: var(--ink-2); font-size: 15px; margin-bottom: 1.1rem; }
  .contact a {
    display: inline-block; font-size: 14px; font-weight: 500;
    background: var(--accent-solid); color: var(--fg-on-accent);
    padding: 0.5rem 1rem; border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .contact a:hover { background: var(--accent-solid-hover); }
  .contact a:active { transform: translateY(1px); }

  /* footer */
  footer {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem;
    font-family: var(--mono); font-size: var(--fs-12); color: var(--ink-3);
    padding-top: 1.6rem; border-top: 1px solid var(--rule);
  }
  footer nav { display: flex; gap: 0.9rem; }
  footer nav a { color: var(--ink-3); transition: color var(--dur-fast) var(--ease-out); }
  footer nav a:hover { color: var(--accent); }

  /* article */
  .back { font-family: var(--mono); font-size: 13px; color: var(--ink-3); display: inline-block; margin-bottom: 2.5rem; transition: color var(--dur-fast) var(--ease-out); }
  .back:hover { color: var(--accent); }
  .post-title { font-family: var(--font-display); font-size: var(--fs-36); font-weight: 600; letter-spacing: var(--ls-heading); line-height: var(--lh-snug); margin-bottom: 0.6rem; }
  .post-meta { font-family: var(--mono); font-size: var(--fs-12); color: var(--ink-3); margin-bottom: 2rem; }
  .prose { font-size: 17px; line-height: var(--lh-loose); }
  .prose > * + * { margin-top: 1.1em; }
  .prose h2 { font-family: var(--font-display); font-size: var(--fs-22); font-weight: 600; letter-spacing: var(--ls-heading); line-height: var(--lh-snug); margin-top: 2em; }
  .prose code { font-family: var(--mono); font-size: 0.88em; background: var(--card); box-shadow: var(--hairline); padding: 0.1em 0.35em; border-radius: var(--radius-1); }
  .prose pre { background: var(--card); box-shadow: var(--hairline); padding: 1rem; border-radius: var(--radius-3); overflow-x: auto; font-size: 13px; }
  .prose pre code { background: none; box-shadow: none; padding: 0; }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose blockquote { border-left: 2px solid var(--kobalt-500); padding-left: 1em; color: var(--ink-2); }
</style>
