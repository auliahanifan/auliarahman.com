---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const saved = localStorage.getItem('ah-theme');
      const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
      if ((saved ?? (prefersDark ? 'dark' : 'light')) === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body>
    <button class="theme-toggle" aria-label="ganti tema">
      <svg class="moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <main class="wrap">
      <slot />
    </main>
    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        if (next === 'dark') root.setAttribute('data-theme', 'dark');
        else root.removeAttribute('data-theme');
        localStorage.setItem('ah-theme', next);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --bg-2: #f2f0ea;
    --ink: #161513;
    --ink-2: #3a3834;
    --ink-3: #7a7570;
    --ink-4: #a8a39c;
    --rule: #e6e3dc;
    --accent: #b4531d;
    --lede-hi: rgba(180, 83, 29, 0.18);
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', -apple-system, system-ui, sans-serif;
  }
  html[data-theme='dark'] {
    --bg: #0f0f0e;
    --bg-2: #1a1a18;
    --ink: #ece9e2;
    --ink-2: #c8c4bb;
    --ink-3: #8a857c;
    --ink-4: #5e5a53;
    --rule: #232321;
    --accent: #e8985f;
    --lede-hi: rgba(232, 152, 95, 0.32);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; overflow-x: hidden; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--ink); color: var(--bg); }

  .wrap { max-width: 640px; margin: 0 auto; padding: 5rem 1.6rem; }

  .theme-toggle {
    position: fixed; top: 1.2rem; right: 1.2rem;
    width: 34px; height: 34px; border-radius: 50%;
    border: 1px solid var(--rule); background: var(--bg); color: var(--ink-3);
    display: grid; place-items: center; cursor: pointer;
  }
  .theme-toggle:hover { color: var(--ink); }
  .theme-toggle .sun { display: none; }
  html[data-theme='dark'] .theme-toggle .moon { display: none; }
  html[data-theme='dark'] .theme-toggle .sun { display: block; }

  /* header */
  .name-row { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  h1 { font-family: var(--mono); font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
  .role { color: var(--ink-2); }
  .role a, .prose a { border-bottom: 1px solid var(--ink-4); padding-bottom: 1px; }
  .role a:hover, .prose a:hover { border-color: var(--ink); }

  /* lede */
  .lede {
    font-size: 18px; margin: 2rem 0 3rem; max-width: 52ch;
    padding-top: 1.6rem; border-top: 1px solid var(--rule);
  }
  .lede em {
    font-style: normal; padding: 0 1px;
    background: linear-gradient(180deg, transparent 62%, var(--lede-hi) 62%);
  }

  /* sections */
  section { margin-bottom: 2.8rem; }
  .label {
    font-family: var(--mono); font-size: 12px; color: var(--ink-4);
    text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 0.9rem;
  }
  .row {
    display: block; padding: 0.85rem 0; border-top: 1px solid var(--rule);
  }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .row-head { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .row-title { font-family: var(--mono); font-size: 14px; font-weight: 700; }
  .row-tag { font-family: var(--mono); font-size: 11px; font-weight: 500; color: var(--accent); }
  .row-date { font-family: var(--mono); font-size: 12px; color: var(--ink-4); margin-left: auto; white-space: nowrap; }
  .row-desc { color: var(--ink-3); font-size: 15px; margin-top: 0.2rem; }
  a.row:hover .row-title { color: var(--accent); }

  /* currently */
  .now {
    background: var(--bg-2); border-radius: 6px; padding: 1rem 1.2rem;
    font-family: var(--mono); font-size: 13px; line-height: 1.8;
    display: grid; grid-template-columns: max-content 1fr; column-gap: 1.4rem;
  }
  .now dt { color: var(--ink-4); }
  .now dd { color: var(--ink-2); }

  /* contact */
  .contact { border: 1px solid var(--rule); border-radius: 6px; padding: 1.4rem; }
  .contact h2 { font-family: var(--mono); font-size: 14px; font-weight: 700; margin-bottom: 0.6rem; }
  .contact p { color: var(--ink-3); font-size: 15px; margin-bottom: 0.9rem; }
  .contact a { font-family: var(--mono); font-size: 13px; color: var(--accent); }

  /* footer */
  footer {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem;
    font-family: var(--mono); font-size: 12px; color: var(--ink-4);
    padding-top: 1.6rem; border-top: 1px solid var(--rule);
  }
  footer nav { display: flex; gap: 0.9rem; }
  footer nav a { color: var(--ink-3); }
  footer nav a:hover { color: var(--ink); }

  /* article */
  .back { font-family: var(--mono); font-size: 13px; color: var(--ink-3); display: inline-block; margin-bottom: 2.5rem; }
  .back:hover { color: var(--ink); }
  .post-title { font-family: var(--mono); font-size: 20px; font-weight: 700; margin-bottom: 0.4rem; }
  .post-meta { font-family: var(--mono); font-size: 12px; color: var(--ink-4); margin-bottom: 2rem; }
  .prose { font-size: 17px; }
  .prose > * + * { margin-top: 1.1em; }
  .prose h2 { font-family: var(--mono); font-size: 15px; margin-top: 2em; }
  .prose code { font-family: var(--mono); font-size: 0.88em; background: var(--bg-2); padding: 0.1em 0.35em; border-radius: 4px; }
  .prose pre { background: var(--bg-2); padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 13px; }
  .prose pre code { background: none; padding: 0; }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose blockquote { border-left: 2px solid var(--rule); padding-left: 1em; color: var(--ink-3); }
</style>
