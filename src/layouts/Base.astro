---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: string;
  ogImage?: string;
  ogImageAlt?: string;
}
import '../styles/tokens.css';
const {
  title,
  description,
  noindex = false,
  lang = 'en',
  ogImage: ogImagePath = '/og.jpg',
  ogImageAlt = 'Aulia Rahman Hanifan: Corporate AI Trainer, Tech & AI Consultant, Senior Product Engineer',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aulia Rahman Hanifan',
  url: Astro.site?.href,
  image: new URL('/aulia.jpg', Astro.site).href,
  jobTitle: ['Corporate AI Trainer', 'Tech & AI Consultant', 'Senior Product Engineer'],
  address: { '@type': 'PostalAddress', addressLocality: 'Yogyakarta', addressCountry: 'ID' },
  sameAs: ['https://github.com/auliahanifan', 'https://www.linkedin.com/in/hanifan/', 'https://x.com/auliarahmanhf'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Aulia Rahman" />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <meta name="theme-color" content="#F4F5F7" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script>
      import { StatsigClient } from '@statsig/js-client';
      import { StatsigSessionReplayPlugin } from '@statsig/session-replay';
      import { StatsigAutoCapturePlugin } from '@statsig/web-analytics';

      new StatsigClient(
        'client-aiYClkckIVOVI4v7Gur6hxZBhRHqPnVTDCN3fHsQhxF',
        {},
        { plugins: [new StatsigSessionReplayPlugin(), new StatsigAutoCapturePlugin()] },
      ).initializeAsync();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-head wrap">
      <a href="/" class="sig" aria-label="Aulia Rahman, home">
        <img src="/signature.svg" width="112" height="72" alt="" />
      </a>
      <nav aria-label="Main navigation">
        <a href="/#services">Services</a>
        <a href="/#work">Work</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-foot wrap">
      <span>© 2026 · just one page</span>
      <nav aria-label="Social links">
        <a href="https://github.com/auliahanifan">GitHub</a>
        <a href="https://www.linkedin.com/in/hanifan/">LinkedIn</a>
        <a href="https://x.com/auliarahmanhf">X</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  html, body { overflow-x: clip; }
  body {
    background: var(--bg-page);
    color: var(--fg-1);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: var(--lh-normal);
    letter-spacing: var(--ls-body);
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--kobalt-500); text-decoration: none; }
  a { touch-action: manipulation; }
  a:active { color: var(--kobalt-700); }
  @media (hover: hover) and (pointer: fine) {
    a:hover { color: var(--kobalt-600); }
    .site-head nav a:hover, .post .back:hover { color: var(--kobalt-600); }
  }
  img, svg { display: block; max-width: 100%; }
  ::selection { background: var(--kobalt-100); color: var(--ink-900); }
  :focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; border-radius: var(--radius-1); }
  [id] { scroll-margin-top: 16px; }
  .skip-link { position: absolute; top: 12px; left: 24px; z-index: 10; padding: 12px 16px; background: var(--ink-900); color: var(--abu-0); border-radius: var(--radius-2); transform: translateY(calc(-100% - 16px)); }
  .skip-link:focus { transform: none; color: var(--abu-0); }

  .wrap { max-width: var(--content-max); margin: 0 auto; padding-left: 24px; padding-right: 24px; }
  .mono { font-family: var(--font-mono); color: var(--ink-500); }

  .site-head { padding-top: 20px; padding-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px 16px; flex-wrap: wrap; }
  .site-head .sig img { width: 112px; height: auto; }
  .site-head nav { display: flex; gap: 8px 24px; font-size: 15px; flex-wrap: wrap; }
  .site-head nav a { color: var(--ink-700); min-height: 44px; display: inline-flex; align-items: center; }

  .site-foot {
    padding-top: 24px; padding-bottom: 40px;
    display: flex; justify-content: space-between; align-items: center; gap: 12px 16px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 13px; color: var(--ink-500);
  }
  .site-foot nav { display: flex; gap: 20px; }
  .site-foot nav a { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }

  /* article */
  .post { max-width: var(--prose-max); padding-top: 32px; padding-bottom: 72px; }
  .post .back { font-family: var(--font-mono); font-size: 13px; color: var(--ink-500); display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 20px; }
  .post-title { font-size: clamp(32px, 6vw, 48px); font-weight: 600; letter-spacing: var(--ls-display); line-height: 1.05; text-wrap: balance; margin-bottom: 12px; }
  .post-meta { font-family: var(--font-mono); font-size: 13px; color: var(--ink-500); margin-bottom: 32px; }
  .prose { font-size: 17px; line-height: var(--lh-loose); color: var(--ink-700); overflow-wrap: break-word; }
  .prose > * + * { margin-top: 1.1em; }
  .prose h2 { font-size: var(--fs-22); font-weight: 600; letter-spacing: var(--ls-heading); line-height: var(--lh-snug); color: var(--ink-900); margin-top: 2em; }
  .prose a { color: var(--kobalt-600); text-decoration: underline; text-underline-offset: 3px; }
  .prose code { font-family: var(--font-mono); font-size: 0.88em; background: var(--abu-0); box-shadow: var(--shadow-hairline); padding: 0.1em 0.35em; border-radius: var(--radius-1); }
  .prose pre { background: var(--abu-0); box-shadow: var(--shadow-hairline); padding: 1rem; border-radius: var(--radius-3); overflow-x: auto; font-size: 13px; }
  .prose pre code { background: none; box-shadow: none; padding: 0; }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose blockquote { border-left: 2px solid var(--kobalt-500); padding-left: 1em; color: var(--ink-600); }
</style>
