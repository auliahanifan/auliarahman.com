---
import Base from '../layouts/Base.astro';
// Copy halaman ditulis Gemini (gemini-api CLI), lalu dicek terhadap fakta program sebelum dipasang.
import c from '../data/ai-mentorship-copy.json';

// URL Web App dari scripts/ai-mentorship/Code.gs (berakhiran /exec). Kosong = form belum aktif.
const endpoint = 'https://script.google.com/macros/s/AKfycbwtUmuF9QEofkTUns5DS0U_bTJ5fwQ3vS2YIFKkewZVepx-cFtjZ465VOobaTHJiAC1/exec';

// Ganti sebelum halaman dibagikan.
const rekening = { bank: 'NAMA BANK', no: '0000000000', nama: 'Nama Pemilik Rekening' };

const whatsapp = 'https://wa.me/6285121038080';

// Harus sama dengan TRACKS di scripts/ai-mentorship/Code.gs.
// close: pendaftaran ditutup mulai tanggal ini 00.00 WIB, yaitu hari pertemuan pertama.
const tracks = [
  { id: 'finance', name: 'Finance, accounting, tax', when: 'Rabu, 2 dan 9 Desember', close: '2026-12-02', free: 2, paid: 4 },
  { id: 'marketing', name: 'Marketing, content, sales', when: 'Selasa, 1 dan 8 Desember', close: '2026-12-01', free: 2, paid: 4 },
  { id: 'hr', name: 'HR', when: 'Kamis, 3 dan 10 Desember', close: '2026-12-03', free: 2, paid: 4 },
  { id: 'management', name: 'Management, direksi, business owner', when: 'Senin, 30 November dan 7 Desember', close: '2026-11-30', free: 0, paid: 6 },
];

// ponytail: logo diduplikasi dari free-training-claude.astro; pindah ke data bersama kalau daftar ini berubah
const logos = [
  { name: 'Noice', src: '/logos/noice.svg', h: 24 },
  { name: 'Delegasi', src: '/logos/delegasi.png', h: 28 },
  { name: 'BukuWarung', src: '/logos/bukuwarung.png', h: 40 },
  { name: 'Traveloka', src: '/logos/traveloka.png', h: 24 },
  { name: 'Alterra', src: '/logos/alterra.svg', h: 26 },
];

const { heroPoints, pains, examples, stack, topics, steps } = c;
const yoeOpts = ['Kurang dari 2 tahun', '2 sampai 5 tahun', '5 sampai 10 tahun', 'Lebih dari 10 tahun'];
const pengalamanOpts = ['Belum pernah', 'Pernah coba-coba', 'Sudah rutin'];
const aiOpts = ['ChatGPT', 'Claude', 'Gemini', 'Lainnya', 'Belum langganan'];
---

<Base
  title="AI Mentorship · Aulia Rahman"
  description="Dua malam untuk setup AI sampai paham pekerjaanmu. Mentorship tatap muka di Yogyakarta untuk finance, marketing, HR, dan management."
  lang="id"
  noindex
>
  <section class="wrap hero">
    <span class="mono">AI Mentorship · Yogyakarta · Tatap muka</span>
    <h1>{c.h1}</h1>
    <p class="lede">{c.lede}</p>
    <ul class="points">
      {heroPoints.map((p) => <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{p}</li>)}
    </ul>
    <a class="btn btn-accent hero-cta" href="#daftar">{c.cta}
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
    <small class="hero-meta">{c.heroMeta}</small>
  </section>

  <section class="wrap sec">
    <span class="mono">Yang sering terjadi</span>
    <h2>{c.painsH2}</h2>
    <ul class="pains">
      {pains.map((p) => <li>{p}</li>)}
    </ul>
    <p class="sub">{c.painsAfter}</p>
  </section>

  <section class="wrap sec">
    <span class="mono">Selama 2 malam</span>
    <h2>{c.topicsH2}</h2>
    <ol class="topics">
      {topics.map((t, i) => (
        <li class="card topic">
          <span class="mono num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <strong>{t.title}</strong>
          <span>{t.desc}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap sec">
    <span class="mono">Jadwal</span>
    <h2>{c.tracksH2}</h2>
    <p class="sub">{c.tracksSub} Pendaftaran tiap track ditutup H-1 pertemuan pertama.</p>
    <ul class="tracks">
      {tracks.map((t) => (
        <li class="card track" data-track={t.id}>
          <strong>{t.name}</strong>
          <span class="when">{t.when}</span>
          <span class="mono">19.00 sampai 21.30 WIB</span>
          <span class="ex">Contoh latihan: {examples[t.id as keyof typeof examples]}</span>
          <span class="seats">
            {t.free > 0 && <span class="seat">{t.free} kursi free, diseleksi</span>}
            <span class="seat" data-paid={t.paid}>{t.paid} kursi berbayar</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap sec">
    <span class="mono">Yang kamu dapat</span>
    <h2>{c.stackH2}</h2>
    <ol class="card stack">
      {stack.map((s) => (
        <li>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <div><strong>{s.title}</strong><span>{s.desc}</span></div>
        </li>
      ))}
    </ol>
    <p class="anchor">{c.anchor}</p>
  </section>

  <section class="wrap sec">
    <span class="mono">Biaya dan garansi</span>
    <h2>{c.pathsH2}</h2>
    <div class="paths">
      <div class="card path">
        <strong>{c.freeTitle}</strong>
        <ul class="ticks">
          {c.freeBullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
      <div class="card path">
        <strong>{c.paidTitle}</strong>
        <ul class="ticks">
          {c.paidBullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap sec mentor">
    <img src="/aulia.jpg" width="120" height="120" alt="Aulia Rahman Hanifan" loading="lazy" />
    <div class="mentor-text">
      <span class="mono">Yang mendampingi</span>
      <h2>Aulia Rahman Hanifan</h2>
      <p class="sub">{c.mentorBio}</p>
      <ul class="logos" aria-label="Tempat saya pernah bekerja">
        {logos.map((l) => <li><img src={l.src} alt={l.name} height={l.h} style={`height:${l.h}px`} loading="lazy" /></li>)}
      </ul>
    </div>
  </section>

  <section class="wrap sec">
    <span class="mono">Cara daftar</span>
    <h2>{c.stepsH2}</h2>
    <ol class="steps">
      {steps.map((s) => <li>{s}</li>)}
    </ol>
  </section>

  <section id="daftar" class="wrap reg">
    <div class="intro">
      <span class="mono">Pendaftaran</span>
      <h2>Daftar AI Mentorship</h2>
      <p>{c.regIntro}</p>
      <div class="bank">
        <span class="mono">Rekening tujuan</span>
        <strong>{rekening.bank} · {rekening.no}</strong>
        <span>a.n. {rekening.nama}</span>
      </div>
    </div>

    <form id="reg-form" class="form" novalidate data-endpoint={endpoint} data-wa={whatsapp}>
      <fieldset class="field">
        <legend>Track</legend>
        <div class="opts col">
          {tracks.map((t) => (
            <label data-track={t.id}>
              <input type="radio" name="track" value={t.id} data-close={t.close} data-free={t.free} data-paid={t.paid} data-name={t.name} required />
              <span class="opt-text"><span>{t.name}</span><small>{t.when}</small></span>
            </label>
          ))}
        </div>
      </fieldset>
      <fieldset class="field">
        <legend>Jalur</legend>
        <div class="opts">
          <label><input type="radio" name="jalur" value="free" required /><span>Free, diseleksi</span></label>
          <label><input type="radio" name="jalur" value="berbayar" required /><span>Berbayar, tanpa seleksi</span></label>
        </div>
        <small id="jalur-note">Jalur free tidak tersedia untuk track management.</small>
      </fieldset>
      <p id="waitlist-note" class="note" hidden>Kursi berbayar track ini sudah penuh. Kamu tetap bisa daftar dan masuk waiting list. Kalau tidak ada kursi yang terbuka, uangnya dikembalikan.</p>
      <div class="field">
        <label for="f-nama">Nama</label>
        <input id="f-nama" name="nama" type="text" autocomplete="name" required maxlength="120" />
      </div>
      <div class="field">
        <label for="f-wa">Nomor WhatsApp</label>
        <input id="f-wa" name="wa" type="tel" maxlength="20" inputmode="tel" autocomplete="tel" required placeholder="081234567890" />
      </div>
      <div class="pair">
        <div class="field">
          <label for="f-jabatan">Jabatan</label>
          <input id="f-jabatan" name="jabatan" type="text" required maxlength="120" placeholder="mis. Staf pajak" />
        </div>
        <div class="field">
          <label for="f-perusahaan">Perusahaan</label>
          <input id="f-perusahaan" name="perusahaan" type="text" required maxlength="120" placeholder="mis. Kopi Senja" />
        </div>
      </div>
      <fieldset class="field">
        <legend>Pengalaman kerja</legend>
        <div class="opts">
          {yoeOpts.map((o) => <label><input type="radio" name="yoe" value={o} required /><span>{o}</span></label>)}
        </div>
      </fieldset>
      <fieldset class="field">
        <legend>Seberapa sering pakai AI untuk kerja?</legend>
        <div class="opts">
          {pengalamanOpts.map((o) => <label><input type="radio" name="pengalaman" value={o} required /><span>{o}</span></label>)}
        </div>
      </fieldset>
      <fieldset class="field">
        <legend>Langganan AI berbayar apa saja?</legend>
        <div class="opts">
          {aiOpts.map((o) => <label><input type="checkbox" name="ai" value={o} /><span>{o}</span></label>)}
        </div>
      </fieldset>
      <div class="field">
        <label for="f-rutin">Pekerjaan rutin apa yang ingin kamu percepat dengan AI?</label>
        <textarea id="f-rutin" name="rutin" rows="3" required maxlength="1000" placeholder="mis. rekap faktur pajak bulanan dari email vendor"></textarea>
      </div>
      <div class="field">
        <label for="f-bukti">Bukti transfer Rp200.000</label>
        <input id="f-bukti" name="bukti" type="file" accept="image/jpeg,image/png,image/webp,image/heic,application/pdf" required />
        <small>Foto atau PDF, maksimal 5 MB. Rekening tujuan: {rekening.bank} {rekening.no} a.n. {rekening.nama}.</small>
      </div>
      <div class="field" id="rekening-field" hidden>
        <label for="f-rekening">Rekening untuk pengembalian dana</label>
        <input id="f-rekening" name="rekening" type="text" maxlength="200" placeholder="Bank, nomor rekening, atas nama" />
      </div>
      <button id="reg-submit" class="btn btn-accent" type="submit">Daftar
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
      <p id="reg-error" class="form-error" role="alert"></p>
    </form>

    <div id="reg-done" class="form done" hidden tabindex="-1">
      <svg class="ic done-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <h2>Terima kasih, pendaftaranmu sudah masuk</h2>
      <p>Kamu sedang diarahkan ke WhatsApp untuk konfirmasi. Kalau tidak terbuka otomatis, <a id="done-wa" href={whatsapp}>klik di sini</a>.</p>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#reg-form')!;
  const btn = document.querySelector<HTMLButtonElement>('#reg-submit')!;
  const err = document.querySelector<HTMLElement>('#reg-error')!;
  const done = document.querySelector<HTMLElement>('#reg-done')!;
  const rekeningField = document.querySelector<HTMLElement>('#rekening-field')!;
  const waitlistNote = document.querySelector<HTMLElement>('#waitlist-note')!;
  const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const first = (n: string) => form.querySelector<HTMLInputElement>(`[name=${n}]`)!;
  const endpoint = form.dataset.endpoint || '';
  const trackInputs = [...form.querySelectorAll<HTMLInputElement>('[name=track]')];
  const freeInput = form.querySelector<HTMLInputElement>('[name=jalur][value=free]')!;

  // Kursi berbayar terpakai per track, dari Sheet. Kosong kalau gagal dimuat: form tetap jalan, server yang menentukan waiting list.
  let paidUsed: Record<string, number> = {};
  const isFull = (t: HTMLInputElement) => (paidUsed[t.value] ?? 0) >= Number(t.dataset.paid);

  // Tutup track mulai hari pertemuan pertama (WIB).
  for (const t of trackInputs) {
    if (Date.now() >= new Date(t.dataset.close + 'T00:00:00+07:00').getTime()) {
      t.disabled = true;
      t.closest('label')!.querySelector('small')!.textContent = 'Pendaftaran ditutup';
      document.querySelector(`.track[data-track=${t.value}]`)?.classList.add('closed');
    }
  }

  if (endpoint) {
    fetch(endpoint)
      .then((r) => r.json())
      .then((out) => {
        if (!out.ok) return;
        paidUsed = out.paid;
        document.querySelectorAll<HTMLElement>('.track').forEach((card) => {
          const seat = card.querySelector<HTMLElement>('[data-paid]')!;
          const left = Math.max(0, Number(seat.dataset.paid) - (paidUsed[card.dataset.track!] ?? 0));
          seat.textContent = left ? `Sisa ${left} dari ${seat.dataset.paid} kursi berbayar` : 'Kursi berbayar penuh, buka waiting list';
          seat.classList.toggle('full', !left);
        });
        sync();
      })
      .catch(() => {});
  }

  const sync = () => {
    const track = trackInputs.find((t) => t.checked);
    const noFree = track?.dataset.free === '0';
    freeInput.disabled = noFree;
    if (noFree && freeInput.checked) freeInput.checked = false;
    const jalur = new FormData(form).get('jalur');
    const waitlist = !!track && jalur === 'berbayar' && isFull(track);
    waitlistNote.hidden = !waitlist;
    rekeningField.hidden = !(jalur === 'free' || waitlist);
  };
  form.addEventListener('change', sync);

  const fail = (msg: string, focus?: HTMLElement) => {
    err.textContent = msg;
    focus?.focus();
  };

  const readFile = (f: File) =>
    new Promise<string>((ok, no) => {
      const r = new FileReader();
      r.onload = () => ok(String(r.result).split(',')[1]);
      r.onerror = no;
      r.readAsDataURL(f);
    });

  const errors: Record<string, string> = {
    closed: 'Pendaftaran track ini sudah ditutup.',
    bukti: 'Bukti transfer belum valid. Unggah foto atau PDF maksimal 5 MB.',
    rekening: 'Isi rekening untuk pengembalian dana.',
    contact: 'Nomor WhatsApp belum valid. Contoh: 081234567890.',
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) ?? '').trim();
    const track = trackInputs.find((t) => t.checked);
    if (!track) return fail('Pilih track kamu.', first('track'));
    if (!v('jalur')) return fail('Pilih jalur pendaftaran.', first('jalur'));
    if (!v('nama')) return fail('Nama belum diisi.', el('nama'));
    const wa = v('wa').replace(/[\s-]/g, '');
    if (!/^(\+62|62|0)8\d{7,12}$/.test(wa)) return fail('Nomor WhatsApp belum valid. Contoh: 081234567890.', el('wa'));
    if (!v('jabatan')) return fail('Jabatan belum diisi.', el('jabatan'));
    if (!v('perusahaan')) return fail('Perusahaan belum diisi.', el('perusahaan'));
    if (!v('yoe')) return fail('Pilih lama pengalaman kerja kamu.', first('yoe'));
    if (!v('pengalaman')) return fail('Pilih seberapa sering kamu pakai AI.', first('pengalaman'));
    const ai = d.getAll('ai').map(String);
    if (!ai.length) return fail('Pilih minimal satu langganan AI, atau "Belum langganan".', first('ai'));
    if (!v('rutin')) return fail('Tulis pekerjaan rutin yang ingin kamu percepat.', el('rutin'));
    const file = el('bukti').files?.[0];
    if (!file) return fail('Unggah bukti transfer.', el('bukti'));
    if (file.size > 5 * 1024 * 1024) return fail('Ukuran bukti transfer maksimal 5 MB.', el('bukti'));
    if (!rekeningField.hidden && !v('rekening')) return fail('Isi rekening untuk pengembalian dana.', el('rekening'));
    if (!endpoint) return fail('Form belum aktif. Hubungi Aulia lewat WhatsApp.');

    err.textContent = '';
    btn.disabled = true;
    btn.firstChild!.textContent = 'Mengirim… ';
    try {
      const payload = {
        track: track.value,
        jalur: v('jalur'),
        nama: v('nama'),
        wa,
        jabatan: v('jabatan'),
        perusahaan: v('perusahaan'),
        yoe: v('yoe'),
        pengalaman: v('pengalaman'),
        ai: ai.join(', '),
        rutin: v('rutin'),
        rekening: rekeningField.hidden ? '' : v('rekening'),
        bukti: { name: file.name, type: file.type, data: await readFile(file) },
      };
      // text/plain supaya tidak ada preflight CORS ke Apps Script.
      const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) });
      const out = await res.json();
      if (!out.ok) throw new Error(out.error);
      const jalur = payload.jalur === 'free' ? 'free' : 'berbayar';
      const msg = `Halo Aulia, saya ${payload.nama} sudah daftar AI Mentorship track ${track.dataset.name}, jalur ${jalur}${out.status === 'waiting list' ? ' (waiting list)' : ''}.`;
      const link = document.querySelector<HTMLAnchorElement>('#done-wa')!;
      link.href = `${form.dataset.wa}?text=${encodeURIComponent(msg)}`;
      form.hidden = true;
      done.hidden = false;
      done.focus();
      location.href = link.href;
    } catch (ex) {
      fail(errors[(ex as Error).message] || 'Pendaftaran gagal terkirim. Coba lagi sebentar lagi.');
      btn.disabled = false;
      btn.firstChild!.textContent = 'Daftar ';
    }
  });
</script>

<style>
  .hero { padding-top: 32px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .mono { font-size: 14px; color: var(--kobalt-700); }
  h1 { font-size: clamp(34px, 6vw, 60px); font-weight: 600; letter-spacing: var(--ls-display); line-height: 1.05; text-wrap: balance; max-width: 900px; }
  h2 { font-size: clamp(26px, 4vw, 38px); font-weight: 600; letter-spacing: var(--ls-heading); line-height: 1.1; text-wrap: balance; }
  .lede { font-size: 19px; line-height: 1.55; color: var(--ink-700); text-wrap: pretty; max-width: 680px; }
  .points { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 20px; }
  .points li { display: flex; align-items: flex-start; gap: 8px; line-height: 1.45; font-size: 15px; color: var(--ink-800); }
  .points .ic { color: var(--mint-600); width: 18px; height: 18px; margin-top: 2px; }
  .btn.hero-cta { width: auto; margin-top: 8px; }
  .hero-meta { font-size: 14px; color: var(--ink-500); }

  .pains { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 4px 0 8px; max-width: 720px; }
  .pains li { position: relative; padding: 14px 16px 14px 44px; border-radius: 12px; background: var(--koral-50); color: var(--ink-800); font-size: 16px; line-height: 1.5; text-wrap: pretty; }
  .pains li::before { content: '×'; position: absolute; left: 16px; top: 12px; font-size: 20px; font-weight: 600; color: var(--koral-600); }

  .ex { font-size: 14px; line-height: 1.5; color: var(--ink-700); text-wrap: pretty; padding-top: 4px; }

  .stack { list-style: none; padding: 8px clamp(16px, 3vw, 28px); margin-top: 8px; max-width: 820px; }
  .stack li { display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--abu-200); }
  .stack li:last-child { border-bottom: 0; }
  .stack .ic { color: var(--mint-600); margin-top: 2px; }
  .stack div { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .stack strong { font-size: 17px; font-weight: 600; color: var(--ink-900); text-wrap: balance; }
  .stack span { font-size: 15px; line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }
  .anchor { max-width: 820px; padding: 16px 18px; border-radius: 12px; background: var(--kobalt-50); color: var(--ink-800); font-size: 16px; line-height: 1.55; text-wrap: pretty; }
  .anchor strong { color: var(--ink-900); font-weight: 600; }

  .sec.mentor { flex-direction: row; align-items: flex-start; gap: 24px; }
  .mentor > img { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; flex: none; }
  .mentor-text { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .logos { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 4px; }
  .logos img { width: auto; display: block; opacity: .75; filter: grayscale(1); }

  .sec { padding-top: 40px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 12px; }
  .sub { font-size: 17px; line-height: 1.55; color: var(--ink-700); max-width: 680px; text-wrap: pretty; }
  .card { background: var(--abu-0); border-radius: var(--radius-4); box-shadow: var(--shadow-1), var(--shadow-hairline); }

  .topics { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 8px; }
  .topic { padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .topic strong { font-size: 17px; font-weight: 600; color: var(--ink-900); text-wrap: balance; }
  .topic > span:last-child { font-size: 15px; line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }
  .num { font-size: 13px; }

  .tracks { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 8px; }
  .track { padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .track strong { font-size: 17px; font-weight: 600; color: var(--ink-900); text-wrap: balance; }
  .when { font-size: 15px; color: var(--ink-800); }
  .seats { display: flex; flex-direction: column; gap: 6px; margin-top: auto; padding-top: 10px; }
  .seat { font-size: 13px; font-weight: 500; padding: 6px 10px; border-radius: 8px; background: var(--kobalt-50); color: var(--kobalt-700); width: fit-content; }
  .seat.full { background: var(--amber-50); color: var(--amber-800); }
  .track.closed { opacity: .55; }
  .track.closed .seats::after { content: 'Pendaftaran ditutup'; font-size: 13px; font-weight: 600; color: var(--ink-700); }

