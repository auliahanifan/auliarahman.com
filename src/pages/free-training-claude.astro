---
import Base from '../layouts/Base.astro';

const whatsapp = 'https://wa.me/6285121038080';
const wa = `${whatsapp}?text=${encodeURIComponent('Halo, saya tertarik dengan sesi training Claude yang gratis. Mohon informasi jadwal yang masih tersedia.')}`;

const heroPoints = ['Gratis, jumlah sesi terbatas', 'Praktik dengan contoh pekerjaan sehari-hari', 'Tatap muka di Yogyakarta, maksimal 15 peserta'];

// Program percontohan: syarat dan pembagian tanggung jawab.
const pilotGet = [
  '3 jam praktik dengan contoh dari pekerjaan sehari-hari peserta',
  'Contoh prompt awal untuk pekerjaan peserta',
];
const pilotAsk = ['Izin memotret dan merekam sesi', 'Satu testimoni singkat sesudahnya', 'Izin menggunakan logo organisasi Anda di portofolio'];
const pilotPrepare = ['Tempat dengan layar atau proyektor', 'Laptop dan akun Claude untuk tiap peserta', 'Transportasi, jika sesi berlangsung di luar Yogyakarta'];

// Diambil dari bagian "Hasil" di silabus.
const outcomes = [
  { title: 'Tiga pekerjaan rutin yang dapat dipercepat dengan AI', desc: 'Dicoba langsung dengan contoh dari pekerjaan peserta.' },
  { title: 'Cara menulis instruksi yang hasilnya bagus', desc: 'Dicoba dengan dua pendekatan, lalu hasilnya dibandingkan. Peserta juga membawa pulang contoh prompt awal.' },
  { title: 'Satu pekerjaan berulang yang dapat dibuat lebih praktis', desc: 'Peserta memilih satu pekerjaan rutin yang cocok dijadikan skill di Claude, sehingga instruksi yang sama tidak perlu diulang.' },
  { title: 'Panduan data yang boleh dan tidak boleh dibagikan ke AI', desc: 'Pembagian hijau, kuning, merah. Dapat menjadi bahan awal pedoman pemakaian AI di kantor.' },
];

const lokasiOpts = ['Yogyakarta', 'Di luar Yogyakarta'];

// ponytail: logo diduplikasi dari index.astro; pindah ke data bersama kalau daftar ini berubah
const logos = [
  { name: 'Noice', src: '/logos/noice.svg', h: 24 },
  { name: 'Delegasi', src: '/logos/delegasi.png', h: 28 },
  { name: 'BukuWarung', src: '/logos/bukuwarung.png', h: 40 },
  { name: 'Traveloka', src: '/logos/traveloka.png', h: 24 },
  { name: 'Alterra', src: '/logos/alterra.svg', h: 26 },
];

// Klien sengaja anonim, sama seperti di beranda.
const delivered = [
  { who: 'Perusahaan tambang dan sumber daya', how: 'Tatap muka' },
  { who: 'Tim sekretariat seorang tokoh publik' },
  { who: 'Lebih dari 500 peserta webinar', how: 'Taalenta · Leviq' },
];

const tasks = ['Email dan balasan', 'Notulen rapat', 'Laporan dan rekap', 'Riset dan pembanding', 'Presentasi dan dokumen'];

const modules = [
  { tone: 'kobalt', title: 'Mengenal Claude', desc: 'Apa saja kemampuan dan keterbatasannya, agar harapan peserta sesuai sejak awal.' },
  { tone: 'ungu', title: 'Cara memperoleh hasil yang lebih baik', desc: 'Cara menulis instruksi yang jelas, plus cara memeriksa jawaban: halusinasi, angka, dan sumber.' },
  { tone: 'langit', title: 'Kapan menggunakan chat, kapan menggunakan fitur lain', desc: 'Mana yang cocok untuk tiap jenis pekerjaan: percakapan biasa, atau Claude yang mengerjakan tugas berlangkah pada file. Ada demo langsung dan latihan.' },
  { tone: 'mint', title: 'Agar tidak mengulang instruksi yang sama', desc: 'Skills dan konektor: cara membuat Claude bekerja dengan standar yang Anda tetapkan dan terhubung ke aplikasi kerja, sehingga hasilnya konsisten.' },
  { tone: 'amber', title: 'Data apa yang boleh dimasukkan ke AI', desc: 'Pembagian hijau, kuning, merah, UU PDP, anonimisasi, dan pengaturan privasi.' },
];

// Contoh agenda 3 jam. Diambil dari silabus pelatihan nyata, tanpa nama klien dan contoh khusus industri.
// mod = indeks di `modules`, judul modul ikut dari sana supaya tidak ganda.
const agenda = [
  { time: '00.00 – 00.05', title: 'Pembukaan, tujuan sesi, dan aturan dasar data', form: 'Pengantar', min: 5,
    result: 'Peserta tahu batas data sebelum mulai berlatih.' },
  { time: '00.05 – 00.25', mod: 0, form: 'Paparan dan diskusi', min: 20,
    result: 'Dapat menjelaskan secara ringkas apa itu Claude, perbedaannya dari alternatif, dan batasannya.' },
  { time: '00.25 – 01.10', mod: 1, form: 'Paparan, demo, latihan', min: 45,
    practice: 'Setiap peserta mengerjakan satu tugas nyata dengan dua pendekatan: prompt lengkap sekali jalan, dan Claude mewawancarai peserta terlebih dahulu. Kemudian hasilnya dibandingkan.',
    result: 'Kumpulan prompt awal untuk pekerjaan masing-masing.' },
  { time: '01.10 – 01.20', title: 'Jeda', min: 10, rest: true },
  { time: '01.20 – 02.00', mod: 2, form: 'Demo dan latihan', min: 40,
    practice: 'Demo satu tugas kerja utuh, dari file mentah sampai hasil jadi. Peserta lalu menjalankan satu tugas dari pekerjaannya sendiri.',
    result: 'Peserta mengetahui fitur Claude yang cocok untuk tiap jenis pekerjaan, serta tiga pekerjaan rutin yang dapat dipercepat.' },
  { time: '02.00 – 02.30', mod: 3, form: 'Demo dan latihan', min: 30,
    practice: 'Demo memasang dan memakai plugin pada satu tugas rutin. Peserta merumuskan satu pekerjaan berulang yang cocok dijadikan skill.',
    result: 'Satu pekerjaan rutin yang cocok dijadikan skill.' },
  { time: '02.30 – 02.55', mod: 4, form: 'Diskusi dan latihan', min: 25,
    practice: 'Memilah contoh kasus ke tiga kategori (hijau, kuning, merah) dan mendiskusikan alasannya.',
    result: 'Panduan tiga kategori yang dapat menjadi bahan awal pedoman pemakaian AI di kantor.' },
  { time: '02.55 – 03.00', title: 'Penutup dan langkah lanjut', form: 'Rangkuman', min: 5 },
];

const prepare = ['Laptop untuk tiap peserta', 'Akun Claude', 'Koneksi internet', 'Ruang dengan layar atau proyektor'];

const format = [
  'Di akun Claude peserta sendiri',
  'Setiap modul ada praktik langsung',
  'Contoh disesuaikan dengan bidang kerja tim',
  'Didampingi 1:1 saat latihan',
  'Durasi dan jumlah peserta fleksibel',
  'Tatap muka di Yogyakarta',
];

const takeaways = [
  { title: 'Slide', desc: 'Materi lengkap dalam bentuk PDF.' },
  { title: 'Contoh prompt', desc: 'Sebagai referensi. Setelah sesi, pesertanya tidak bergantung pada contoh itu.' },
  { title: 'Panduan latihan', desc: 'Latihan dengan data contoh yang aman.' },
];

const steps = [
  { title: 'Diskusi singkat', desc: 'Soal tim, pekerjaan sehari-hari, dan apa yang ingin diubah.' },
  { title: 'Proposal yang disesuaikan', desc: 'Kurikulum, contoh, dan format yang pas dengan pesertanya.' },
  { title: 'Pelaksanaan sesi', desc: 'Di lokasi Anda. Anda menyiapkan ruang dan perangkat, saya membawa programnya.' },
];
---

<Base
  title="Training Claude untuk Kerja Kantor · Aulia Rahman"
  description="Belajar menggunakan Claude untuk pekerjaan sehari-hari. Training di kantor untuk tim, gratis untuk beberapa sesi pertama, tatap muka di Yogyakarta."
  lang="id"
  noindex
  ogImage="/og-free-training-claude.jpg"
  ogImageAlt="Training Claude untuk kerja kantor, oleh Aulia Rahman Hanifan"
>
  <section class="hero-band">
    <div class="hero wrap">
      <img class="photo" src="/aulia.jpg" width="400" height="400" alt="Aulia Rahman Hanifan" fetchpriority="high" />
      <div class="mono eyebrow">Training Claude · Inhouse · Yogyakarta</div>
      <h1>Belajar menggunakan Claude untuk pekerjaan sehari-hari</h1>
      <p class="lede">Training langsung di kantor Anda, dengan materi yang disesuaikan untuk tim. Selama 3 jam, peserta berpraktik dengan contoh dari pekerjaan mereka, seperti menulis email, membuat notulen rapat, dan menyusun laporan.</p>
      <div class="actions">
        <a class="btn btn-accent" href="#minta">Ambil sesi gratis
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a class="btn btn-light" href="#agenda">Lihat agenda 3 jam</a>
      </div>
      <ul class="hero-points">
        {heroPoints.map((p) => (
          <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="percontohan" class="wrap pilot">
    <div class="pilot-head">
      <div class="mono">Sesi gratis</div>
      <h2>Ingin mencoba training Claude untuk tim Anda? Gratis</h2>
      <p>Saya sedang membuka beberapa sesi gratis untuk tim di Yogyakarta. Paket ini pernah saya bawakan seharga Rp8 juta. Saat ini saya ingin menambah pengalaman dan dokumentasi training tatap muka untuk portofolio, sehingga sebagai gantinya saya meminta izin dokumentasi, testimoni, dan logo. Durasi 3 jam, maksimal 15 peserta per sesi.</p>
    </div>
    <div class="pilot-grid">
      <div class="card pilot-card">
        <span class="mono">Yang Anda dapatkan</span>
        <ul class="ticks">
          {pilotGet.map((t) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{t}</li>
          ))}
        </ul>
      </div>
      <div class="card pilot-card">
        <span class="mono">Persyaratan</span>
        <div class="pilot-sub">
          <strong>Dari Anda</strong>
          <ul class="ticks">
            {pilotAsk.map((t) => (
              <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{t}</li>
            ))}
          </ul>
        </div>
        <div class="pilot-sub">
          <strong>Disiapkan oleh pihak yang mengundang</strong>
          <ul class="ticks">
            {pilotPrepare.map((t) => (
              <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{t}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap outcomesec">
    <div class="outcome-head">
      <div class="mono">Yang peserta bawa pulang</div>
      <h2>Apa yang didapat tim setelah 3 jam</h2>
    </div>
    <ul class="outcomes">
      {outcomes.map((o) => (
        <li class="card outcome"><strong>{o.title}</strong><span>{o.desc}</span></li>
      ))}
    </ul>
  </section>

  <section class="wrap about">
    <div class="about-text">
      <div class="mono">Yang mengajar</div>
      <h2>Saya Aulia, product engineer yang kini melatih tim menggunakan AI.</h2>
      <p>Tujuh tahun membangun produk di lima startup, dua di antaranya didukung YC. Karena itu, contoh yang saya ajarkan berasal dari pengalaman kerja.</p>
      <ul class="logos" aria-label="Tempat saya pernah bekerja">
        {logos.map((l) => (
          <li><img src={l.src} alt={l.name} style={`height: ${l.h}px`} loading="lazy" /></li>
        ))}
      </ul>
    </div>
    <div class="delivered">
      <span class="mono">Telah digunakan oleh</span>
      <ul>
        {delivered.map((d) => (
          <li><span>{d.who}</span>{d.how && <span class="mono">{d.how}</span>}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="materi" class="program-band">
    <div class="wrap program-grid">
      <div class="program-intro">
        <div class="mono">Yang dilatih</div>
        <h2>Contoh pekerjaan yang dipraktikkan bersama Claude</h2>
        <p class="program-lede">Materi disesuaikan dengan pekerjaan pesertanya, sehingga contohnya berupa dokumen dan situasi yang memang mereka hadapi.</p>
        <ul class="chips" aria-label="Contoh tugas">
          {tasks.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <ol class="card modules" aria-label="Kurikulum">
        {modules.map((m, i) => (
          <li class="module" data-tone={m.tone}>
            <span class="module-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{m.title}</h3>
              <p>{m.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="agenda" class="wrap agendasec">
    <div class="agenda-head">
      <div class="mono">Contoh agenda</div>
      <h2>Apa saja yang dipelajari dalam 3 jam</h2>
      <p>Ini contoh, bukan paket baku. Urutan, durasi, dan latihan akan saya sesuaikan dengan peserta dan pekerjaan mereka.</p>
    </div>
    <ol class="card agenda" aria-label="Contoh agenda sesi 3 jam">
      {agenda.map((a) => (
        <li class:list={['slot', { rest: a.rest }]}>
          <span class="mono slot-time">{a.time}</span>
          <div class="slot-body">
            <div class="slot-title">
              {a.mod !== undefined && <span class="mono slot-mod">Modul {a.mod + 1}</span>}
              <strong>{a.mod !== undefined ? modules[a.mod].title : a.title}</strong>
              <span class="mono slot-meta">{a.form ? `${a.form} · ` : ''}{a.min} menit</span>
            </div>
            {a.practice && <p><span class="mono tag">Latihan</span>{a.practice}</p>}
            {a.result && <p><span class="mono tag">Hasil</span>{a.result}</p>}
          </div>
        </li>
      ))}
      <li class="slot total"><span class="mono slot-time">Total</span><div class="slot-body"><strong>180 menit</strong></div></li>
    </ol>
    <div class="prepare">
      <span class="mono">Yang perlu disiapkan</span>
      <ul class="chips">
        {prepare.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="wrap formatsec">
    <div class="format-col">
      <div class="mono">Formatnya</div>
      <h2>Training di kantor, sesuai kebutuhan tim</h2>
      <ul class="format">
        {format.map((f) => (
          <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{f}</li>
        ))}
      </ul>
    </div>
    <div class="sub">
      <div class="takeaways-wrap">
        <span class="mono">Materi yang diterima</span>
        <ul class="takeaways">
          {takeaways.map((t) => (
            <li class="card takeaway"><strong>{t.title}</strong><span>{t.desc}</span></li>
          ))}
        </ul>
      </div>
      <div class="steps-wrap">
        <span class="mono">Alur pelaksanaan</span>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="mono step-num">Langkah {i + 1}</span><strong>{s.title}</strong><span>{s.desc}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section id="minta" class="wrap cta-sec">
    <div class="contact">
      <div class="contact-copy">
        <span class="mono">Yogyakarta · Tatap muka</span>
        <h2>Daftar sesi gratis</h2>
        <p>Silakan ceritakan organisasi, jumlah peserta, dan pekerjaan yang ingin dipercepat. Jumlah sesi terbatas, sehingga saya akan mengabari lewat WhatsApp mengenai kecocokan dan jadwalnya.</p>
      </div>
      <form id="minta-form" class="form" autocomplete="off">
        <div class="field">
          <label for="f-nama">Nama dan organisasi</label>
          <input id="f-nama" name="nama" type="text" autocomplete="name" placeholder="mis. Budi, Komunitas X" />
        </div>
        <div class="field">
          <label for="f-peserta">Jumlah peserta</label>
          <input id="f-peserta" name="peserta" type="number" min="2" max="15" inputmode="numeric" placeholder="2 sampai 15 orang" />
        </div>
        <fieldset class="field">
          <legend>Lokasi sesi</legend>
          <div class="opts">
            {lokasiOpts.map((o, i) => (
              <label><input type="radio" name="lokasi" value={o} checked={i === 0} /><span>{o}</span></label>
            ))}
          </div>
          <small>Di luar Yogyakarta, biaya transportasi ditanggung pihak yang mengundang.</small>
        </fieldset>
        <div class="field">
          <label for="f-kerja">Pekerjaan yang ingin dipercepat</label>
          <textarea id="f-kerja" name="kerja" rows="3" placeholder="mis. notulen rapat, laporan mingguan, balas email klien"></textarea>
          <small>Punya satu tugas nyata? Tuliskan di sini, dan kita dapat mencobanya bersama saat berdiskusi.</small>
        </div>
        <a id="minta-wa" class="btn btn-accent" href={wa} data-base={whatsapp} target="_blank" rel="noopener">Kirim lewat WhatsApp
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <p class="form-note">Pesan tersusun otomatis, lalu terbuka di WhatsApp untuk Anda kirim.</p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Pesan WA disusun di browser dari isian form; tanpa JS, tombol tetap membuka pesan umum.
  const form = document.querySelector<HTMLFormElement>('#minta-form');
  const link = document.querySelector<HTMLAnchorElement>('#minta-wa');
  if (form && link) {
    const base = link.dataset.base ?? '';
    const build = () => {
      const d = new FormData(form);
      const v = (k: string) => String(d.get(k) ?? '').trim();
      const lines = [
        v('nama')
          ? `Halo, saya ${v('nama')}. Saya tertarik dengan sesi training Claude yang gratis.`
          : 'Halo, saya tertarik dengan sesi training Claude yang gratis.',
        v('peserta') && `Jumlah peserta: ${v('peserta')} orang.`,
        `Lokasi: ${v('lokasi')}.`,
        v('kerja') && `Pekerjaan yang ingin dipercepat: ${v('kerja')}.`,
        'Mohon informasi jadwal yang masih tersedia.',
      ].filter(Boolean);
      link.href = `${base}?text=${encodeURIComponent(lines.join('\n'))}`;
    };
    form.addEventListener('input', build);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      link.click();
    });
    build();
  }
</script>

<style>
  h1, h2 { font-weight: 600; text-wrap: balance; }
  h2 { font-size: clamp(28px, 5vw, 36px); letter-spacing: var(--ls-heading); line-height: 1.1; }
  .mono { font-size: 14px; }
  .ic { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .card { background: var(--abu-0); border-radius: var(--radius-3); box-shadow: var(--shadow-hairline); }

  /* buttons, sama dengan beranda */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 52px; padding: 12px 22px; border-radius: var(--radius-pill);
    max-width: 100%; font-size: 17px; font-weight: 500; letter-spacing: -0.01em; text-align: center; text-wrap: balance;
    user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
    backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn:active { transform: scale(.98); }
  .btn:focus-visible { transition: none; }
  .btn-accent .ic { transition: transform var(--dur-fast) var(--ease-out); }
  .btn-accent { background: rgba(58,91,255,.95); color: #fff; border: 1px solid rgba(255,255,255,.45); box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 8px 24px rgba(58,91,255,.28); }
  .btn-light { background: rgba(255,255,255,.55); color: var(--ink-900); border: 1px solid rgba(255,255,255,.9); box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 6px 20px rgba(11,13,18,.08); }
  .btn-accent:active { color: #fff; }
  .btn-light:active { color: var(--ink-900); }
  @media (hover: hover) and (pointer: fine) {
    .btn-accent:hover { background: var(--kobalt-600); color: #fff; }
    .btn-accent:hover:not(:focus-visible) .ic { transform: translateX(3px); }
    .btn-light:hover { background: var(--abu-0); color: var(--ink-900); }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .btn-accent .ic { transition: none; }
    .btn:active, .btn-accent:hover:not(:focus-visible) .ic { transform: none; }
  }

  /* hero */
  .hero-band { background: var(--surface-hero); border-bottom: 1px solid var(--abu-200); }
  .hero { padding-top: 32px; padding-bottom: 72px; display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 48px; row-gap: 20px; align-items: start; }
  .hero > :not(.photo) { grid-column: 1; }
  .photo { grid-column: 2; grid-row: 1 / span 5; align-self: center; width: clamp(240px, 28vw, 340px); height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-4); box-shadow: var(--shadow-2); }
  h1 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: var(--ls-display); line-height: 1.02; }
  .eyebrow { color: var(--ink-500); }
  .lede { font-size: clamp(17px, 2vw, 20px); line-height: 1.55; color: var(--ink-700); text-wrap: pretty; max-width: 600px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }

  .hero-points { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 4px; }
  .hero-points li { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; color: var(--ink-700); }
  .hero-points .ic { width: 16px; height: 16px; color: var(--kobalt-600); }

  /* program percontohan */
  .pilot { padding-top: 64px; padding-bottom: 8px; display: flex; flex-direction: column; gap: 24px; }
  .pilot-head { display: flex; flex-direction: column; gap: 12px; max-width: 680px; }
  .pilot-head .mono { color: var(--kobalt-700); }
  .pilot-head p { font-size: 18px; line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }
  .pilot-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .pilot-card { padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; border-top: 3px solid var(--kobalt-500); min-width: 0; }
  .pilot-card > .mono { color: var(--kobalt-700); }
  .pilot-sub { display: flex; flex-direction: column; gap: 8px; }
  .pilot-sub strong { font-size: 14px; font-weight: 600; color: var(--ink-800); }
  .ticks { list-style: none; display: flex; flex-direction: column; gap: 10px; }
