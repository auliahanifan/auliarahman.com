---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// ponytail: data kerja inline; pindah ke collection kalau sudah > 10 entri
const work = [
  { name: 'noice', tag: 'sekarang', desc: 'sistem di balik produk audio yang didengar jutaan orang indonesia', date: 'sep 2025 — sekarang' },
  { name: 'delegasi', tag: 'yc s22', desc: 'platform pembayaran b2b dari nol sampai memproses jutaan dolar', date: 'jan 2023 — mei 2025' },
  { name: 'bukuwarung', tag: 'yc s20 · e-wallet', desc: 'dompet digital untuk jutaan warung, backend dan integrasi pembayaran', date: 'jan 2022 — nov 2022' },
  { name: 'traveloka', tag: 'e-wallet', desc: 'uang elektronik dan tagihan untuk pengguna traveloka', date: 'mei 2021 — jan 2022' },
  { name: 'alterra', tag: 'erp', desc: 'erp desktop untuk pdam, plus tooling otomasi deploy untuk tim', date: 'okt 2019 — mar 2021' },
];

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('id-ID', { month: 'short', year: 'numeric' }).toLowerCase();
---

<Base
  title="aulia rahman hanifan — product engineer, educator, content creator"
  description="Engineer 7 tahun, masih ngantor. Bongkar sistem yang diam-diam ngerugiin kamu, dari dalam."
>
  <header>
    <div class="name-row">
      <h1>aulia rahman hanifan 🤖</h1>
    </div>
    <p class="role">
      engineer di <a href="https://noice.id">noice</a>. sebelumnya delegasi, bukuwarung, traveloka, alterra.
    </p>
  </header>

  <p class="lede">
    aku engineer 7 tahun di startup. kerjaanku: <em>bikin hal rumit jadi jelas, hal mahal jadi murah</em>.
    pembayaran b2b, e-wallet, erp, sekarang produk audio. tiap hari pakai ai buat itu semua.
  </p>

  <section>
    <div class="label">kerja</div>
    {work.map((w) => (
      <div class="row">
        <div class="row-head">
          <span class="row-title">{w.name}</span>
          <span class="row-tag">{w.tag}</span>
          <span class="row-date">{w.date}</span>
        </div>
        <div class="row-desc">{w.desc}</div>
      </div>
    ))}
  </section>

  <section>
    <div class="label">tulisan</div>
    {posts.map((p) => (
      <a class="row" href={`/writing/${p.id}/`}>
        <div class="row-head">
          <span class="row-title">{p.data.title}</span>
          <span class="row-date">{fmt(p.data.date)}</span>
        </div>
        <div class="row-desc">{p.data.description}</div>
      </a>
    ))}
  </section>

  <section>
    <div class="label">saat ini</div>
    <dl class="now">
      <dt>lokasi</dt><dd>yogyakarta, indonesia</dd>
      <dt>shipping</dt><dd>produk di noice</dd>
    </dl>
  </section>

  <section>
    <div class="contact">
      <h2>ngopi di jogja?</h2>
      <p>aku selalu senang ketemu orang yang lagi bikin sesuatu. backend, infra, ai agent, open source, startup. kalau kamu salah satunya, tulis email.</p>
      <a href="mailto:halo@auliarahman.com">halo@auliarahman.com →</a>
    </div>
  </section>

  <footer>
    <span>© 2026 · no cookies · just a page</span>
    <nav>
      <a href="https://github.com/auliahanifan">github</a>
      <a href="https://www.linkedin.com/in/hanifan/">linkedin</a>
      <a href="https://x.com/auliahanifan">x</a>
    </nav>
  </footer>
</Base>
