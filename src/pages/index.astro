---
import Base from '../layouts/Base.astro';

// ponytail: data kerja inline; pindah ke collection kalau sudah > 10 entri
// h = tinggi logo (px), diatur per logo supaya bobot visualnya seimbang
const work = [
  { name: 'Noice', logo: '/logos/noice.svg', h: 24, tag: 'Current', desc: 'The systems behind an audio product heard by millions of Indonesians.' },
  { name: 'Delegasi', logo: '/logos/delegasi.png', h: 28, tag: 'YC S22', desc: 'A B2B payments platform, from zero to processing millions of dollars.' },
  { name: 'BukuWarung', logo: '/logos/bukuwarung.png', h: 40, tag: 'YC S20 · e-wallet', desc: 'A digital wallet for millions of small shops: backend and payment integrations.' },
  { name: 'Traveloka', logo: '/logos/traveloka.png', h: 24, tag: 'E-wallet', desc: 'Electronic money and bill payments for Traveloka users.' },
  { name: 'Alterra', logo: '/logos/alterra.svg', h: 26, tag: 'ERP', desc: 'Desktop ERP for PDAM (regional water utilities), plus deploy automation tooling for the team.' },
];

const mailto = 'mailto:arahmanhanifan@gmail.com';
const mailtoTraining = `${mailto}?subject=${encodeURIComponent('AI training for our team')}`;

const offers = [
  // TODO(owner): durasi dan jumlah peserta per sesi. Jangan tampilkan angka sebelum dikonfirmasi.
  { layer: 'kobalt', title: 'AI Training for Teams', desc: 'Hands-on programs for business, operations, and management teams. Material is tailored to participants’ work and industry, not generic theory.' },
  { layer: 'ungu', title: 'Tech & AI Consulting', desc: 'For companies without an in-house tech team: where AI is worth using, what to build or buy, and what to tackle first.' },
  { layer: 'mint', title: 'Product Engineering', desc: 'Senior product engineering for startups: payments, wallets, and consumer apps at scale.' },
];

// Kurikulum = IP milik Aulia (Pasal 9 ayat 2 PKS ABAD); contoh kasus klien tidak ditampilkan.
const modules = [
  { tone: 'kobalt', title: 'Know the tool', desc: 'Claude’s strengths and limits, so expectations are right from the start.' },
  { tone: 'ungu', title: 'Prompts that work', desc: 'Write a complete prompt or let Claude interview you, then check the output for hallucinations, numbers, and sources.' },
  { tone: 'langit', title: 'Right tool, right job', desc: 'Chat or Cowork, with use cases mapped to each function, live demos, and hands-on practice.' },
  { tone: 'mint', title: 'From one-off to repeatable', desc: 'Plugins, skills, and connectors that turn a good prompt into a way of working.' },
  { tone: 'amber', title: 'Safe data habits', desc: 'What can go into AI: a green, yellow, red framework, Indonesia’s PDP Law, anonymization, and privacy settings.' },
];

// Format & deliverables dari proposal/PKS (Pasal 2 ayat 5–6).
const format = ['Hands-on in your team’s own accounts', 'Examples tailored to your industry', '1:1 support during practice', 'Onsite or online'];
const takeaways = [
  { icon: 'slides', title: 'Slides', desc: 'The full deck as a PDF.' },
  { icon: 'library', title: 'Prompt library', desc: 'Ready-to-use templates for daily work.' },
  { icon: 'guide', title: 'Practice guide', desc: 'Exercises with safe sample data.' },
];

// Klien sengaja anonim.
const delivered = [
  { who: 'A mining & resources company', how: 'Onsite' },
  { who: 'A public figure’s secretariat team', how: 'Online' },
  { who: '500+ webinar participants', how: 'Taalenta · Leviq' },
];

---

<Base
  title="Aulia Rahman: AI Trainer, AI Consultant & Product Engineer"
  description="Corporate AI training, technology consulting, and product engineering for teams and companies. Seven years building products at startups."
>
  <section class="hero-band">
    <div class="hero wrap">
      <img class="photo" src="/aulia.jpg" width="400" height="400" alt="Aulia Rahman Hanifan" fetchpriority="high" />
      <p class="name">Aulia Rahman Hanifan <span>· Yogyakarta</span></p>
      <div class="mono eyebrow">Corporate AI Trainer · Tech &amp; AI Consultant · Senior Product Engineer</div>
      <h1>Complex made clear.<br /> Costly made cheap.</h1>
      <p class="lede">Corporate AI training, technology consulting, and product engineering. Seven years building products at startups, from seed to scale.</p>
      <div class="actions">
        <a class="btn btn-accent" href={mailtoTraining}>Discuss training for your team
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a class="btn btn-light" href={mailto}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Send an email
        </a>
      </div>
    </div>
    <a class="scroll-cue mono" href="#services">What I offer <span aria-hidden="true">↓</span></a>
  </section>

  <section id="services" class="wrap offers-sec">
    <div class="sec-head">
      <h2>What I offer</h2>
      <span class="mono">01 / 04</span>
    </div>
    <div class="offers">
      {offers.map((o) => (
        <div class="card offer" data-layer={o.layer}>
          <h3><span class="dot" aria-hidden="true"></span>{o.title}</h3>
          <p>{o.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="training" class="program-band">
    <div class="wrap program-grid">
      <div class="program-intro">
        <div class="mono">02 / 04 · Training program</div>
        <h2>Claude for everyday work</h2>
        <p class="program-lede">Built to leave your team with effective, safe Claude habits, not just a demo.</p>
        <ul class="format">
          {format.map((f) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{f}</li>
          ))}
        </ul>
        <a class="btn btn-accent" href={mailtoTraining}>Discuss training for your team
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      <div class="program-main">
        <ol class="card modules" aria-label="Curriculum">
          {modules.map((m, i) => (
            <li class="module" data-tone={m.tone}>
              <span class="module-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{m.title}</h3>
                <p>{m.desc}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="takeaways-wrap">
          <span class="mono">Your team leaves with</span>
          <ul class="takeaways">
            {takeaways.map((t) => (
              <li class="card takeaway">
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                  {t.icon === 'slides' && <><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></>}
                  {t.icon === 'library' && <><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M8 7h8"/><path d="M8 11h6"/></>}
                  {t.icon === 'guide' && <><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></>}
                </svg>
                <strong>{t.title}</strong>
                <span>{t.desc}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="delivered">
          <span class="mono">Delivered to</span>
          <ul>
            {delivered.map((d) => (
              <li><span>{d.who}</span><span class="mono">{d.how}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="band">
    <div class="wrap kerja">
      <div class="kerja-intro">
        <div class="kerja-text">
          <div class="mono">03 / 04</div>
          <h2>Work</h2>
          <p>Five startups, from day one to millions of users. That’s why I teach and advise from real experience, not theory.</p>
        </div>
      </div>
      <ol class="jobs">
        {work.map((w) => (
          <li class="job">
            <div class="job-main">
              <div class="job-head">
                <img class="job-logo" src={w.logo} alt={w.name} style={`height: ${w.h}px`} loading="lazy" />
                <span class="mono pill">{w.tag}</span>
              </div>
              <p>{w.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="contact" class="wrap">
    <div class="contact">
      <span class="mono">04 / 04 · Yogyakarta, Indonesia</span>
      <h2>Contact</h2>
      <div class="paths">
        <div class="path">
          <h3>For companies</h3>
          <p>Discuss AI training or consulting for your team.</p>
          <a class="btn btn-accent" href={mailtoTraining}>Discuss training
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="path">
          <h3>For recruiters and fellow builders</h3>
          <p>Product engineering roles, collaboration, or coffee in Jogja.</p>
          <div class="path-actions">
            <a class="btn btn-dark" href={mailto}>Send an email
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a class="btn btn-dark" href="https://www.linkedin.com/in/hanifan/">LinkedIn
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  h1, h2 { font-weight: 600; text-wrap: balance; }
  h2 { font-size: clamp(30px, 5vw, 36px); letter-spacing: var(--ls-heading); line-height: 1.1; }
  .mono { font-size: 14px; }
  .ic { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* buttons — glass, per desain */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 52px; padding: 0 22px; border-radius: var(--radius-pill);
    font-size: 17px; font-weight: 500; letter-spacing: -0.01em; white-space: nowrap;
    backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
    transition: transform var(--dur-fast) var(--ease-out), filter var(--dur-fast) var(--ease-out);
  }
  .btn:hover { filter: brightness(1.05); }
  .btn:active { transform: translateY(1px); }
  .btn-accent { background: rgba(58,91,255,.95); color: #fff; border: 1px solid rgba(255,255,255,.45); box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 8px 24px rgba(58,91,255,.28); }
  .btn-light { background: rgba(255,255,255,.55); color: var(--ink-900); border: 1px solid rgba(255,255,255,.9); box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 6px 20px rgba(11,13,18,.08); }
  .btn-dark { background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(255,255,255,.28); box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 8px 24px rgba(0,0,0,.3); }
  .btn-accent:hover, .btn-dark:hover { color: #fff; }
  .btn-light:hover { color: var(--ink-900); }

  /* hero */
  /* ponytail: 112px = tinggi header di Base.astro (20 + 72 + 20); ubah kalau header berubah */
  .hero-band { background: var(--surface-hero); border-bottom: 1px solid var(--abu-200); min-height: calc(100svh - 112px); display: flex; align-items: center; position: relative; }
  .scroll-cue { position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); font-size: 13px; color: var(--ink-500); display: inline-flex; align-items: center; gap: 6px; padding: 8px; }
  .scroll-cue:hover { color: var(--kobalt-600); }
  .hero { width: 100%; padding-top: 32px; padding-bottom: 64px; display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 48px; row-gap: 20px; align-items: start; }
  .hero > :not(.photo) { grid-column: 1; }
  .photo { grid-column: 2; grid-row: 1 / span 5; align-self: center; width: clamp(240px, 28vw, 380px); height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-4); box-shadow: var(--shadow-2); }
  h1 { font-size: clamp(32px, 4.6vw, 68px); letter-spacing: var(--ls-display); line-height: 1; }
  .name { font-size: 17px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink-900); }
  .name span { color: var(--ink-500); font-weight: 400; }
  .lede { font-size: clamp(17px, 2vw, 20px); line-height: 1.55; color: var(--ink-700); text-wrap: pretty; max-width: 600px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }

  /* layanan + bukti */
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .sec-head > .mono { white-space: nowrap; }
  .card { background: var(--abu-0); border-radius: var(--radius-3); box-shadow: var(--shadow-hairline); }
  .offers-sec { padding-top: 72px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 20px; }
  .offers { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .offer { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .offer h3 { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .offer p { line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }
  /* training program: band kobalt-50 = produk utama */
  .program-band { background: var(--kobalt-50); border-top: 1px solid var(--kobalt-100); }
  .program-grid { padding-top: 72px; padding-bottom: 72px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .program-intro { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .program-intro .mono { color: var(--kobalt-700); }
  .program-lede { font-size: 18px; line-height: 1.5; color: var(--ink-700); text-wrap: pretty; max-width: 420px; }
  .format { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 4px 0 8px; }
  .format li { display: flex; align-items: center; gap: 10px; line-height: 1.4; color: var(--ink-800); }
  .format .ic { width: 18px; height: 18px; color: var(--kobalt-600); }
  .program-main { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .modules { list-style: none; padding: 8px 24px; box-shadow: var(--shadow-1), var(--shadow-hairline); }
  .module { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--abu-100); }
  .module:last-child { border-bottom: 0; }
  .module-num { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; font-family: var(--font-mono); font-size: 13px; font-weight: 500; }
  .module[data-tone='kobalt'] .module-num { background: var(--kobalt-50); color: var(--kobalt-700); }
  .module[data-tone='ungu'] .module-num { background: var(--ungu-50); color: var(--ungu-800); }
  .module[data-tone='langit'] .module-num { background: var(--langit-50); color: var(--langit-800); }
  .module[data-tone='mint'] .module-num { background: var(--mint-50); color: var(--mint-800); }
  .module[data-tone='amber'] .module-num { background: var(--amber-50); color: var(--amber-800); }
  .module h3 { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; margin-bottom: 4px; }
  .module p { line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }
  .takeaways-wrap, .delivered { display: flex; flex-direction: column; gap: 12px; }
  .takeaways { list-style: none; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .takeaway { padding: 18px 20px; display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 2px 12px; align-items: start; align-content: start; }
  .takeaway .ic { grid-row: span 2; width: 22px; height: 22px; color: var(--kobalt-600); margin-top: 1px; }
  .takeaway strong { font-weight: 600; letter-spacing: -0.01em; }
  .takeaway span { font-size: 15px; line-height: 1.45; color: var(--ink-600); }
  .delivered ul { list-style: none; }
  .delivered li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 16px; padding: 12px 0; border-top: 1px solid var(--kobalt-100); line-height: 1.4; }
  .delivered li .mono { font-size: 13px; }
  @media (min-width: 640px) {
    .takeaways { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .takeaway { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .takeaway .ic { grid-row: auto; margin-bottom: 4px; }
    .delivered ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 24px; }
    .delivered li { flex-direction: column; justify-content: flex-start; }
  }
  @media (min-width: 960px) {
    .program-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr); gap: 56px; padding-top: 88px; padding-bottom: 88px; }
    .program-intro { position: sticky; top: 32px; align-self: start; }
    .modules { padding: 8px 32px; }
  }

  /* kerja */
  .band { background: var(--abu-0); border-top: 1px solid var(--abu-200); border-bottom: 1px solid var(--abu-200); }
  .kerja { padding-top: 72px; padding-bottom: 72px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 40px; }
  .kerja-intro { max-width: 320px; position: sticky; top: 32px; align-self: start; }
  .kerja-text { display: flex; flex-direction: column; gap: 12px; }
  .kerja-intro p { line-height: 1.5; color: var(--ink-700); }


  .dot { width: 10px; height: 10px; border-radius: 3px; flex: none; box-shadow: inset 0 0 0 1px rgba(11,13,18,.15); }
  [data-layer='kobalt'] .dot { background: #3A5BFF; }
  [data-layer='ungu'] .dot { background: #8B5CF6; }
  [data-layer='mint'] .dot { background: #25B892; }
  .jobs { list-style: none; min-width: 0; }
  .job { padding: 20px 0; border-top: 1px solid var(--abu-200); }
  .job-main { display: flex; flex-direction: column; gap: 6px; }
  .job-head { display: flex; align-items: center; gap: 6px 10px; flex-wrap: wrap; }
  .job-head { min-height: 40px; }
  .job-logo { width: auto; max-width: 160px; }
  .pill { font-size: 12px; color: var(--ink-600); background: var(--abu-100); border-radius: var(--radius-pill); padding: 3px 10px; }
  .job p { line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }


  /* kontak */
  #contact { margin-top: 72px; padding-bottom: 48px; }
  .contact {
    background: var(--ink-900); color: var(--abu-0); border-radius: var(--radius-4);
    padding: clamp(28px, 6vw, 64px); display: flex; flex-direction: column; gap: 20px; align-items: flex-start;
  }
  .contact .mono { color: var(--abu-300); }
  .contact h2 { font-size: clamp(36px, 5vw, 56px); letter-spacing: var(--ls-display); line-height: 1.05; }
  .paths { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 32px; width: 100%; margin-top: 8px; }
  .path { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .path h3 { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .path .btn, .path-actions { margin-top: auto; }
  .path-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .path p { margin-bottom: 8px; }
  .contact p { max-width: 560px; font-size: 18px; line-height: 1.55; color: var(--abu-200); text-wrap: pretty; }

  @media (max-width: 760px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .photo { grid-column: 1; grid-row: auto; width: 96px; border-radius: var(--radius-3); box-shadow: var(--shadow-1); }
    .offers-sec { padding-top: 56px; padding-bottom: 56px; }
    .program-grid { padding-top: 56px; padding-bottom: 56px; }
    .kerja { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-top: 56px; padding-bottom: 56px; }
    .kerja-intro { position: static; max-width: 480px; }
    #contact { margin-top: 56px; }
  }
  @media (max-width: 560px) {
    h1 { font-size: min(8.6vw, 40px); }
    .scroll-cue { display: none; }
    .lede, .contact p { font-size: 17px; }
  }
  @media (max-width: 400px) {
    .actions .btn, .program-intro .btn { flex: 1 1 100%; align-self: stretch; white-space: normal; text-align: center; padding: 10px 18px; }
    .contact .btn { font-size: 15px; padding: 0 18px; }
  }
</style>
