---
import Base from '../layouts/Base.astro';

const whatsapp = 'https://wa.me/6285726317318';
const wa = `${whatsapp}?text=${encodeURIComponent('Halo, saya sudah melihat portofolio training Anda dan ingin berdiskusi tentang training AI untuk tim kami.')}`;

// Program publik, urut kronologis. Batang dihitung dari jumlah peserta (terbesar = 100%).
const publicPrograms = [
  { month: 'Juni', days: '27–28', title: 'Claude untuk Profesional & Business Owner', org: 'Taalenta (PT Taalenta Digital Inteleksi)', n: 278, unit: 'peserta & alumni' },
  { month: 'Juli', days: '6, 8, 10', title: 'Vibe Coding untuk Non-Developer', org: 'Taalenta (PT Taalenta Digital Inteleksi)', n: 113, unit: 'peserta & alumni' },
  { month: 'Juli–Agustus', days: '22–23 Jul & 25–26 Agu', title: 'Webinar “Bikin Web-App Pakai Claude Code AI untuk Pemula”', org: 'Leviq · 2 batch', n: 200, unit: 'peserta' },
];
const total = publicPrograms.reduce((s, p) => s + p.n, 0);
const max = Math.max(...publicPrograms.map((p) => p.n));

// Klien sengaja anonim.
const covered = [
  'Kekuatan dan batasan Claude',
  'Prompt yang efektif, dan cara memeriksa hasil: halusinasi, angka, sumber',
  'Kapan memakai Chat dan kapan memakai Cowork',
  'Skills, connectors, dan plugin untuk pekerjaan berulang',
  'Data sensitif: kerangka hijau, kuning, merah, dan UU PDP',
];

const sharing = [
  'Kekuatan dan batasan Claude',
  'Prompt yang efektif, dan cara memeriksa hasil: halusinasi, angka, sumber',
];

const konsultasi = [
  'Automation untuk konten, mulai dari riset, brand skills agar konsisten, sampai produksi di cloud',
  'Cara vibe coding secara cerdas',
];

// Dari formulir pendaftaran sharing session (37 pendaftar unik). Hanya angka gabungan, tanpa data pribadi.
// Kebutuhan dihitung dari kata kunci di jawaban bebas, jadi labelnya perkiraan.
const registrants = 37;
// Pemula = belum pernah mencoba Skills, Connectors, Plugins, AskUserQuestion, maupun Claude Code.
const beginners = 27;
const needs = [
  { label: 'Konten dan pemasaran', n: 12, text: 'sekitar 1/3' },
  { label: 'Otomatisasi', n: 8, text: 'sekitar 1/5' },
];
const share = (n: number, of: number) => `${((n / of) * 100).toFixed(1)}%`;
const beginnerPct = Math.round((beginners / registrants) * 100);
---

<Base
  title="Portofolio Training AI · Aulia Rahman"
  description="Portofolio training AI oleh Aulia Rahman: 591 peserta dan alumni dari tiga program publik, satu training untuk perusahaan, dan satu sharing session."
  lang="id"
  noindex
>
  <section class="hero-band">
    <div class="hero wrap">
      <div class="who">
        <img class="photo" src="/aulia.jpg" width="400" height="400" alt="Aulia Rahman Hanifan" fetchpriority="high" />
        <p class="who-text"><b>Aulia Rahman Hanifan</b><span>Corporate AI Trainer · Yogyakarta</span></p>
      </div>
      <div class="hero-text">
        <h1>Mengajar AI untuk pekerjaan sehari-hari.</h1>
        <p class="lede">Training AI tatap muka untuk tim perusahaan, ditambah program publik online.</p>
        <ul class="points">
          <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><b>{total}</b> peserta dan alumni di tiga program publik online</span></li>
          <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Training tatap muka untuk karyawan grup pertambangan</span></li>
          <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Sharing session untuk 22 peserta di Manohara Hotel</span></li>
        </ul>
        <div class="actions">
          <a class="btn btn-accent" href={wa}>Diskusi untuk tim Anda
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-light" href="#perusahaan">Lihat portofolio</a>
        </div>
      </div>
    </div>
  </section>

  <section id="perusahaan" class="wrap section">
    <header class="sec-head">
      <h2>Training untuk perusahaan</h2>
    </header>
    <article class="session">
      <div class="s-main">
        <span class="tag">Tatap muka · 27 Oktober 2026</span>
        <h3>Claude untuk karyawan grup pertambangan</h3>
        <p>Pesertanya staf dari berbagai fungsi, yaitu HR, legal, dan operasional, bukan developer. Latihan dilakukan di akun Claude milik peserta sendiri, dengan contoh data yang sudah dianonimkan.</p>
        <p class="note">Nama klien tidak dicantumkan.</p>
      </div>
      <div class="s-side">
        <h4>Yang dibahas</h4>
        <ul class="list">
          {covered.map((c) => <li>{c}</li>)}
        </ul>
        <h4>Yang diberikan</h4>
        <ul class="list">
          <li>Panduan prompt 5 halaman berisi 8 kebiasaan, lengkap dengan contoh singkat untuk HR, legal, dan operasional</li>
        </ul>
      </div>
    </article>
  </section>

  <section id="publik" class="wrap section">
    <header class="sec-head">
      <h2>Program publik</h2>
      <p>{total} peserta dan alumni di tiga program online, bersama dua penyelenggara.</p>
    </header>
    <ol class="ledger">
      {publicPrograms.map((s) => (
        <li class="row">
          <div class="when">
            <b>{s.month}</b>
            <span>{s.days}</span>
          </div>
          <div class="what">
            <h3>{s.title}</h3>
            <p class="meta">
              <span>{s.org}</span>
              <span class="chip">Zoom</span>
            </p>
          </div>
          <div class="count">
            <p class="num"><b>{s.n}</b><span>{s.unit}</span></p>
            <div class="vt" aria-hidden="true"><i style={`width:${share(s.n, max)}`}></i></div>
          </div>
        </li>
      ))}
    </ol>
    <p class="note">Panjang batang menunjukkan jumlah peserta, dengan yang terbesar sebagai 100%. Di semua program ini saya mengajar sebagai instruktur.</p>
  </section>

  <section id="sharing" class="wrap section">
    <header class="sec-head">
      <h2>Sharing session</h2>
    </header>
    <article class="session">
      <div class="s-main">
        <span class="tag">Tatap muka · 18 November 2026</span>
        <h3>Di Manohara Hotel</h3>
        <p>Diikuti 22 peserta. Gambaran pendaftar di bawah berasal dari formulir pendaftaran.</p>
      </div>
      <div class="s-side">
        <h4>Yang dibahas</h4>
        <ul class="list">
          {sharing.map((c) => <li>{c}</li>)}
        </ul>
        <h4>Konsultasi</h4>
        <ul class="list">
          {konsultasi.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="insight">
        <div class="ins-big">
          <p class="pct"><b>{beginnerPct}%</b><span>pendaftar masih pemula</span></p>
          <div class="vt" aria-hidden="true"><i style={`width:${share(beginners, registrants)}`}></i></div>
          <p class="note">Pemula: belum pernah mencoba Skills, Connectors, Plugins, AskUserQuestion, maupun Claude Code.</p>
        </div>
        <div class="ins-needs">
          <h4>Yang ingin dibantu dengan AI</h4>
          <ul class="rows">
            {needs.map((d) => (
              <li>
                <div class="vl"><span>{d.label}</span><b>{d.text}</b></div>
                <div class="vt" aria-hidden="true"><i style={`width:${share(d.n, registrants)}`}></i></div>
              </li>
            ))}
          </ul>
          <p class="note">Dihitung dari jawaban bebas pendaftar, jadi angkanya perkiraan.</p>
        </div>
      </div>
    </article>
  </section>

  <section class="cta-band">
    <div class="cta wrap">
      <div>
        <h2>Ingin training seperti ini untuk tim Anda?</h2>
        <p>Materinya disesuaikan dengan pekerjaan dan data tim Anda.</p>
      </div>
      <a class="btn btn-accent" href={wa}>Hubungi lewat WhatsApp
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
    <p class="wrap cta-foot">Yogyakarta, Indonesia · Diperbarui November 2026</p>
  </section>
</Base>

<style>
  h1, h2 { font-weight: 600; text-wrap: balance; }
  h3 { font-weight: 600; letter-spacing: -0.02em; line-height: 1.25; }
  h4 { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: var(--ink-900); }
  ul, ol { list-style: none; }
  .ic { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .note { font-size: 13.5px; line-height: 1.5; color: var(--ink-500); text-wrap: pretty; }

  /* buttons, sama dengan halaman lain */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 52px; padding: 12px 22px; border-radius: var(--radius-pill);
    max-width: 100%; font-size: 17px; font-weight: 500; letter-spacing: -0.01em; text-align: center; text-wrap: balance;
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .btn:active { transform: scale(.98); }
  .btn-accent { background: var(--kobalt-500); color: #fff; box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 8px 24px rgba(58,91,255,.28); }
  .btn-light { background: var(--abu-0); color: var(--ink-900); box-shadow: var(--shadow-hairline); }
  .btn-accent:active { color: #fff; }
  .btn-light:active { color: var(--ink-900); }
  @media (hover: hover) and (pointer: fine) {
    .btn-accent:hover { background: var(--kobalt-600); color: #fff; }
    .btn-accent:hover .ic { transform: translateX(3px); }
    .btn-light:hover { background: var(--abu-50); color: var(--ink-900); }
  }
  .btn-accent .ic { transition: transform var(--dur-fast) var(--ease-out); }
  @media (prefers-reduced-motion: reduce) {
    .btn, .btn-accent .ic { transition: none; }
    .btn:active, .btn-accent:hover .ic { transform: none; }
  }

  /* hero */
  .hero-band { background: var(--surface-hero); border-bottom: 1px solid var(--abu-200); }
  .hero { padding-top: clamp(12px, 3vh, 24px); padding-bottom: clamp(24px, 6vh, 64px); display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .who { display: flex; align-items: center; gap: 14px; }
  .photo { width: 64px; height: 64px; flex: none; object-fit: cover; border-radius: 16px; box-shadow: var(--shadow-1); }
  .who-text { display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: var(--ink-500); line-height: 1.3; }
  .who-text b { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; color: var(--ink-900); }
  .hero-text { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  h1 { font-size: clamp(34px, min(7.2vw, 10.5vh), 88px); letter-spacing: var(--ls-display); line-height: 1; }
  .lede { font-size: clamp(17px, 2vw, 21px); line-height: 1.55; color: var(--ink-700); text-wrap: pretty; max-width: 34em; }
  .points { display: flex; flex-direction: column; gap: 12px; }
  .points li { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; line-height: 1.45; color: var(--ink-700); }
  .points .ic { width: 20px; height: 20px; margin-top: 1px; color: var(--kobalt-600); }
  .points b { color: var(--ink-900); font-weight: 600; font-variant-numeric: tabular-nums; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; align-self: stretch; }
  @media (max-width: 519px) { .actions { flex-direction: column; } .actions .btn, .cta .btn { width: 100%; } }
  @media (min-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr) auto; column-gap: 56px; padding-top: clamp(16px, 5vh, 56px); padding-bottom: clamp(32px, 8vh, 88px); align-items: center; }
    .who { grid-column: 2; grid-row: 1; }
    .who-text { display: none; }
    .photo { width: clamp(240px, 24vw, 320px); height: auto; aspect-ratio: 1; border-radius: var(--radius-4); box-shadow: var(--shadow-2); }
    .hero-text { grid-column: 1; grid-row: 1; }
  }

  /* hero harus muat dalam satu layar: di layar pendek, buang yang paling bisa ditunda */
  @media (max-height: 700px) {
    .lede, .actions .btn-light { display: none; }
    .hero-text { gap: 14px; }
    .points { gap: 8px; }
    .points li { font-size: 15px; }
    .photo { width: 48px; height: 48px; border-radius: 12px; }
  }
  @media (max-height: 700px) and (min-width: 860px) {
    .photo { width: clamp(200px, 22vw, 260px); height: auto; border-radius: var(--radius-4); }
  }
  @media (max-width: 359px) and (max-height: 700px) {
    h1 { font-size: 30px; }
    .who-text span, .points li:nth-child(3) { display: none; }
  }
  @media (max-height: 520px) {
    .points, .who-text { display: none; }
  }

  /* hero masuk: satu kali saat dimuat, berurutan dari atas ke bawah */
  @media (prefers-reduced-motion: no-preference) {
    .who, .hero-text > * { animation: rise 520ms var(--ease-out) both; }
    .hero-text > :nth-child(2) { animation-delay: 70ms; }
    .hero-text > :nth-child(3) { animation-delay: 140ms; }
    .hero-text > :nth-child(4) { animation-delay: 210ms; }
  }
  @media (prefers-reduced-motion: reduce) {
    .who, .hero-text > * { animation: fade 200ms ease both; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  @keyframes fade { from { opacity: 0; } }

  /* sections */
  .section { padding-top: 72px; display: flex; flex-direction: column; gap: 32px; }
  .sec-head { display: flex; flex-direction: column; gap: 8px; }
  h2 { font-size: clamp(28px, 4.4vw, 44px); letter-spacing: var(--ls-heading); line-height: 1.05; }
  .sec-head p { color: var(--ink-500); font-size: 17px; }

  /* ledger */
  .ledger { border-bottom: 1px solid var(--abu-200); }
  .row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 24px 0; border-top: 1px solid var(--abu-200); }
  .when { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .when b { font-size: 22px; font-weight: 600; letter-spacing: -0.03em; color: var(--ink-900); }
  .when span { font-size: 14px; color: var(--ink-500); font-variant-numeric: tabular-nums; }
  .what { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; min-width: 0; }
  .what h3 { font-size: clamp(19px, 2.4vw, 24px); text-wrap: balance; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 14.5px; color: var(--ink-600); }
  .chip { font-size: 12.5px; font-weight: 500; padding: 2px 10px; border-radius: var(--radius-pill); background: var(--abu-100); color: var(--ink-700); }
  .count { display: flex; flex-direction: column; gap: 10px; align-self: end; }
  .num { display: flex; align-items: baseline; gap: 8px; }
  .num b { font-size: clamp(32px, 4vw, 44px); font-weight: 600; letter-spacing: var(--ls-heading); line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink-900); }
  .num span { font-size: 14px; color: var(--ink-500); }
  .vt { height: 8px; background: var(--abu-100); border-radius: var(--radius-pill); overflow: hidden; }
  .vt i { display: block; height: 100%; background: var(--kobalt-500); border-radius: var(--radius-pill); transform-origin: left; }
  @media (min-width: 760px) {
    .row { grid-template-columns: 150px minmax(0, 1fr) 230px; gap: 32px; padding: 32px 0; }
    .when { flex-direction: column; align-items: flex-start; gap: 4px; }
    .when b { font-size: 24px; }
  }

  /* sesi tatap muka */
  .session { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .s-main, .s-side { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; min-width: 0; }
  .s-main h3 { font-size: clamp(24px, 3vw, 32px); letter-spacing: var(--ls-heading); text-wrap: balance; }
  .s-main p:not(.note) { color: var(--ink-700); line-height: var(--lh-loose); text-wrap: pretty; max-width: 34em; }
  .tag { background: var(--kobalt-50); color: var(--kobalt-700); font-size: 13px; font-weight: 500; padding: 3px 12px; border-radius: var(--radius-pill); }
  .s-side h4 + .list { margin-bottom: 8px; }
  .list { display: flex; flex-direction: column; gap: 10px; color: var(--ink-700); }
  .list li { padding-left: 18px; position: relative; text-wrap: pretty; line-height: 1.5; }
  .list li::before { content: ''; position: absolute; left: 0; top: .62em; width: 6px; height: 6px; border-radius: 50%; background: var(--kobalt-400); }
  @media (min-width: 860px) {
    .session { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 32px 56px; }
  }

  /* gambaran pendaftar */
  .insight { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; padding: 28px; background: var(--abu-0); border-radius: var(--radius-3); box-shadow: var(--shadow-hairline); }
  .ins-big, .ins-needs { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .pct { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .pct b { font-size: clamp(40px, 6vw, 56px); font-weight: 600; letter-spacing: var(--ls-display); line-height: .95; font-variant-numeric: tabular-nums; color: var(--kobalt-600); }
  .pct span { font-size: 17px; color: var(--ink-700); }
  .rows { display: flex; flex-direction: column; gap: 14px; }
  .vl { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 15px; color: var(--ink-700); margin-bottom: 6px; }
  .vl b { font-weight: 600; color: var(--ink-900); white-space: nowrap; }
  @media (min-width: 860px) {
    .insight { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; padding: 36px; }
  }
  @media (max-width: 420px) { .insight { padding: 20px; } }

  /* penutup */
  .cta-band { margin-top: 96px; background: var(--ink-900); color: var(--abu-0); padding: 72px 0 32px; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px 48px; }
  .cta h2 { max-width: 16em; }
  .cta p { margin-top: 12px; color: var(--abu-300); font-size: 17px; }
  .cta-foot { margin-top: 56px; font-size: 13.5px; color: var(--ink-400); }

  /* satu momen: batang tumbuh saat masuk layar */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .vt i { animation: grow linear both; animation-timeline: view(); animation-range: entry 5% cover 28%; }
    }
  }
  @keyframes grow { from { transform: scaleX(0); } }
</style>
