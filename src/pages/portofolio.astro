---
import Base from '../layouts/Base.astro';

const whatsapp = 'https://wa.me/6285121038080';

// Hanya program yang sudah dibawakan. Batang dihitung dari jumlah peserta, terbesar = 100%.
const programs = [
  { title: 'Claude untuk Profesional & Business Owner', org: 'Taalenta (PT Taalenta Digital Inteleksi)', date: '27–28 Juni 2026', place: 'Zoom', n: 278, unit: 'peserta & alumni' },
  { title: 'Vibe Coding untuk Non-Developer', org: 'Taalenta (PT Taalenta Digital Inteleksi)', date: '6, 8, 10 Juli 2026', place: 'Zoom', n: 113, unit: 'peserta & alumni' },
  { title: 'Webinar “Bikin Web-App Pakai Claude Code AI untuk Pemula”', org: 'Leviq', date: '22–23 Juli & 25–26 Agustus 2026 (2 batch)', place: 'Zoom', n: 200, unit: 'peserta' },
];
const total = programs.reduce((s, p) => s + p.n, 0);
const max = Math.max(...programs.map((p) => p.n));

const facts = [
  { b: '3', t: 'program publik online' },
  { b: '3', t: 'penyelenggara' },
  { b: '2', t: 'sesi tatap muka' },
  { b: 'Juni–Nov 2026', t: 'periode mengajar' },
];

// Klien sengaja anonim.
const covered = [
  'Kekuatan dan batasan Claude',
  'Prompt yang efektif, dan cara memeriksa hasil: halusinasi, angka, sumber',
  'Kapan memakai Chat dan kapan memakai Cowork',
  'Skills, connectors, dan plugin untuk pekerjaan berulang',
  'Data sensitif: kerangka hijau, kuning, merah, dan UU PDP',
];

const sharing = [
  'Kekuatan dan batasan Claude',
  'Prompt yang efektif, dan cara memeriksa hasil: halusinasi, angka, sumber',
];

// Dari formulir pendaftaran sharing session (37 pendaftar unik). Hanya angka gabungan, tanpa data pribadi.
// Kebutuhan dihitung dari kata kunci di jawaban bebas, jadi labelnya perkiraan.
const registrants = 37;
// Pemula = belum pernah mencoba Skills, Connectors, Plugins, AskUserQuestion, maupun Claude Code.
const beginners = 27;
const needs = [
  { label: 'Konten dan pemasaran', n: 12, text: 'sekitar 1/3' },
  { label: 'Otomatisasi', n: 8, text: 'sekitar 1/5' },
];
const pctText = Math.round((beginners / registrants) * 100);
const pct = (n: number) => `${((n / registrants) * 100).toFixed(1)}%`;

const konsultasi = [
  'Automation untuk konten, mulai dari riset, brand skills agar konsisten, sampai produksi di cloud',
  'Cara vibe coding secara cerdas',
];
---

<Base
  title="Portofolio Training AI · Aulia Rahman"
  description="Portofolio training AI oleh Aulia Rahman: 591 peserta dan alumni dari tiga program publik, satu training untuk perusahaan, dan satu sharing session."
  lang="id"
>
  <section class="hero-band">
    <div class="hero wrap">
      <div>
        <div class="mono eyebrow">Portofolio training · Juni–November 2026</div>
        <h1>Mengajar AI untuk pekerjaan sehari-hari.</h1>
        <p class="lede">Sejak Juni 2026 saya mengajar di tiga program publik online, satu training untuk karyawan perusahaan, dan satu sharing session.</p>
      </div>
      <div class="big">
        <b>{total}</b>
        <span>peserta dan alumni<br />dari tiga program publik</span>
      </div>
    </div>
  </section>

  <section class="wrap block">
    <ul class="facts">
      {facts.map((f) => (
        <li class="card fact"><b>{f.b}</b><span>{f.t}</span></li>
      ))}
    </ul>
  </section>

  <section class="wrap block">
    <h2>Program publik</h2>
    <ul class="programs">
      {programs.map((p) => (
        <li class="card program">
          <h3>{p.title}</h3>
          <p class="meta"><span>{p.org}</span><span>{p.date}</span><span>{p.place}</span></p>
          <div class="bar">
            <div class="track"><div class="fill" style={`width:${((p.n / max) * 100).toFixed(1)}%`}></div></div>
            <div class="n">{p.n} <small>{p.unit}</small></div>
          </div>
        </li>
      ))}
    </ul>
    <p class="note">Panjang batang menunjukkan jumlah peserta, dengan program terbesar sebagai 100%. Di semua program ini saya mengajar sebagai instruktur.</p>
  </section>

  <section class="wrap block">
    <h2>Training untuk perusahaan</h2>
    <div class="card case">
      <div>
        <span class="tag">Tatap muka · 27 Oktober 2026</span>
        <h3>Claude untuk karyawan grup pertambangan</h3>
        <p>Pesertanya staf dari berbagai fungsi, yaitu HR, legal, dan operasional, bukan developer. Latihan dilakukan di akun Claude milik peserta sendiri, dengan contoh data yang sudah dianonimkan.</p>
        <p class="note">Nama klien tidak dicantumkan.</p>
      </div>
      <div>
        <h3>Yang dibahas</h3>
        <ul class="list">
          {covered.map((c) => <li>{c}</li>)}
        </ul>
        <h3 class="sub">Yang diberikan</h3>
        <ul class="list">
          <li>Panduan prompt 5 halaman berisi 8 kebiasaan, lengkap dengan contoh singkat untuk HR, legal, dan operasional</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap block">
    <h2>Sharing session</h2>
    <div class="card case">
      <div>
        <span class="tag">Tatap muka · 18 November 2026</span>
        <h3>Sharing session di Manohara Hotel</h3>
        <p>Diikuti 22 peserta. Gambaran pendaftar di bawah berasal dari formulir pendaftaran.</p>
      </div>
      <div>
        <h3>Yang dibahas</h3>
        <ul class="list">
          {sharing.map((c) => <li>{c}</li>)}
        </ul>
        <h3 class="sub">Konsultasi</h3>
        <ul class="list">
          {konsultasi.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="viz">
        <section class="chart">
          <h3>Tingkat pengalaman pendaftar</h3>
          <ul class="rows">
            <li>
              <div class="vl"><span>Pemula</span><b>{pctText}%</b></div>
              <div class="vt" aria-hidden="true"><i style={`width:${pct(beginners)}`}></i></div>
            </li>
          </ul>
          <p class="note">Pemula: belum pernah mencoba Skills, Connectors, Plugins, AskUserQuestion, maupun Claude Code.</p>
        </section>
        <section class="chart">
          <h3>Yang ingin dibantu dengan AI</h3>
          <ul class="rows">
            {needs.map((d) => (
              <li>
                <div class="vl"><span>{d.label}</span><b>{d.text}</b></div>
                <div class="vt" aria-hidden="true"><i style={`width:${pct(d.n)}`}></i></div>
              </li>
            ))}
          </ul>
          <p class="note">Dihitung dari jawaban bebas pendaftar, jadi angkanya perkiraan.</p>
        </section>
      </div>
    </div>
  </section>

  <section class="wrap block last">
    <div class="contact">
      <div>
        <b>Ingin training seperti ini untuk tim Anda?</b>
        <p>Materinya disesuaikan dengan pekerjaan dan data tim Anda.</p>
      </div>
      <div class="links">
        <a href={whatsapp}>Hubungi lewat WhatsApp</a>
      </div>
    </div>
    <p class="note">Yogyakarta, Indonesia · Diperbarui November 2026</p>
  </section>
</Base>

<style>
  h1, h2 { font-weight: 600; text-wrap: balance; }
  h2 { font-size: var(--fs-22); letter-spacing: var(--ls-heading); line-height: 1.1; }
  h3 { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; }
  ul { list-style: none; }
  .mono { font-size: 14px; }
  .eyebrow { color: var(--ink-500); margin-bottom: 16px; }
  .note { font-size: 13.5px; color: var(--ink-500); }
  .card { background: var(--abu-0); border-radius: var(--radius-3); box-shadow: var(--shadow-hairline); }

  .hero-band { background: var(--surface-hero); border-bottom: 1px solid var(--abu-200); }
  .hero { padding-top: 32px; padding-bottom: 56px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 48px; align-items: end; }
  h1 { font-size: clamp(30px, 4.6vw, 54px); letter-spacing: var(--ls-display); line-height: 1.04; }
  .lede { margin-top: 16px; font-size: clamp(17px, 2vw, 20px); line-height: 1.55; color: var(--ink-700); text-wrap: pretty; max-width: 560px; }
  .big { text-align: right; }
  .big b { display: block; font-size: clamp(72px, 12vw, 120px); font-weight: 600; line-height: .9; letter-spacing: var(--ls-display); color: var(--kobalt-500); font-variant-numeric: tabular-nums; }
  .big span { display: block; margin-top: 8px; font-size: 14px; color: var(--ink-500); }
  @media (max-width: 720px) { .hero { grid-template-columns: minmax(0, 1fr); } .big { text-align: left; } }

  .block { padding-top: 40px; display: flex; flex-direction: column; gap: 16px; }
  .block.last { padding-bottom: 64px; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .fact { padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; }
  .fact b { font-size: 24px; font-weight: 600; letter-spacing: var(--ls-heading); font-variant-numeric: tabular-nums; }
  .fact span { font-size: 14px; color: var(--ink-500); }

  .programs { display: flex; flex-direction: column; gap: 12px; }
  .program { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .meta { font-size: 14px; color: var(--ink-500); display: flex; flex-wrap: wrap; gap: 2px 16px; }
  .bar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; margin-top: 4px; }
  .track { height: 8px; background: var(--kobalt-50); border-radius: var(--radius-pill); overflow: hidden; }
  .fill { height: 100%; background: var(--kobalt-500); border-radius: var(--radius-pill); }
  .n { font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .n small { font-weight: 400; font-size: 13px; color: var(--ink-500); }
  @media (max-width: 420px) { .bar { grid-template-columns: minmax(0, 1fr); gap: 8px; } }

  .case { padding: 24px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; }
  .case > div { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .tag { background: var(--kobalt-50); color: var(--kobalt-700); font-size: 13px; font-weight: 500; padding: 3px 10px; border-radius: var(--radius-pill); }
  .case p { color: var(--ink-700); text-wrap: pretty; }
  .case .note { color: var(--ink-500); }
  .sub { margin-top: 8px; }
  .case > .viz { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; padding-top: 24px; border-top: 1px solid var(--abu-200); align-items: start; }
  .chart { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .chart h3 { font-size: 16px; }
  .rows { display: flex; flex-direction: column; gap: 10px; }
  @media (max-width: 720px) { .case > .viz { grid-template-columns: minmax(0, 1fr); } }
  .vl { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 14px; color: var(--ink-700); }
  .vl b { font-weight: 600; color: var(--ink-900); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .vt { height: 8px; margin-top: 4px; background: var(--abu-100); border-radius: var(--radius-pill); overflow: hidden; }
  .vt i { display: block; height: 100%; background: var(--kobalt-500); border-radius: var(--radius-pill); }
  .list { display: flex; flex-direction: column; gap: 8px; color: var(--ink-700); }
  .list li { padding-left: 16px; position: relative; text-wrap: pretty; }
  .list li::before { content: ''; position: absolute; left: 0; top: .65em; width: 6px; height: 6px; border-radius: 50%; background: var(--kobalt-400); }
  @media (max-width: 720px) { .case { grid-template-columns: minmax(0, 1fr); padding: 20px; } }

  .contact { background: var(--kobalt-50); border-radius: var(--radius-3); padding: 22px 24px; display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between; }
  .contact b { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
  .contact p { color: var(--ink-600); }
  .links { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .links a { min-height: 44px; display: inline-flex; align-items: center; font-weight: 500; overflow-wrap: anywhere; }
</style>
