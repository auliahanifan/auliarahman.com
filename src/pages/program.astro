---
import '../styles/tokens.css';
import { modules, format, takeaways, delivered, steps } from '../data/training';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>AI for everyday work: AI training program</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="sheet">
      <header class="head">
        <img class="photo" src="/aulia.jpg" width="400" height="400" alt="Aulia Rahman Hanifan" />
        <div class="who">
          <p class="name">Aulia Rahman Hanifan <span>· Yogyakarta, Indonesia</span></p>
          <p class="mono roles">Corporate AI Trainer · Tech &amp; AI Consultant · Senior Product Engineer</p>
        </div>
      </header>

      <section class="title">
        <div>
          <p class="mono kicker">AI training program</p>
          <h1>AI for everyday work</h1>
          <p class="lede">Built to leave your team with effective, safe AI habits, not just a demo.</p>
        </div>
        <ul class="format">
          {format.map((f) => (
            <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{f}</li>
          ))}
        </ul>
      </section>

      <section class="block">
        <p class="mono label">Curriculum</p>
        <ol class="card modules">
          {modules.map((m, i) => (
            <li class="module" data-tone={m.tone}>
              <span class="module-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{m.title}</h3>
                <p>{m.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="cols">
        <div class="col">
          <p class="mono label">Your team leaves with</p>
          <ul class="list">
            {takeaways.map((t) => (
              <li>
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
                  {t.icon === 'slides' && <><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></>}
                  {t.icon === 'library' && <><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M8 7h8"/><path d="M8 11h6"/></>}
                  {t.icon === 'guide' && <><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></>}
                </svg>
                <div><strong>{t.title}</strong><span>{t.desc}</span></div>
              </li>
            ))}
          </ul>
        </div>
        <div class="col">
          <p class="mono label">How it works</p>
          <ol class="list steps">
            {steps.map((s, i) => (
              <li>
                <span class="step-num">{i + 1}</span>
                <div><strong>{s.title}</strong><span>{s.desc}</span></div>
              </li>
            ))}
          </ol>
        </div>
        <div class="col">
          <p class="mono label">Delivered to</p>
          <ul class="delivered">
            {delivered.map((d) => (
              <li><span>{d.who}</span><span class="mono">{d.how}</span></li>
            ))}
          </ul>
        </div>
      </section>

      <footer class="foot">
        <img class="sig" src="/signature.svg" alt="" />
        <p class="mono contact">arahmanhanifan@gmail.com · auliarahman.com · linkedin.com/in/hanifan</p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 0; }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    background: var(--abu-100);
    color: var(--ink-900);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    letter-spacing: var(--ls-body);
    -webkit-font-smoothing: antialiased;
  }
  ul, ol { list-style: none; }
  .mono { font-family: var(--font-mono); color: var(--ink-600); font-size: 11.5px; letter-spacing: 0; }

  .sheet {
    width: 210mm; height: 297mm; margin: 0 auto; overflow: hidden;
    padding: 13mm 14mm 11mm; display: flex; flex-direction: column; gap: 24px;
    background: var(--abu-0);
  }
  @media print { body { background: none; } .sheet { margin: 0; } }

  .head { display: flex; align-items: center; gap: 14px; }
  .photo { width: 56px; height: 56px; border-radius: var(--radius-3); object-fit: cover; box-shadow: var(--shadow-1); }
  .who { flex: 1; }
  .name { font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
  .roles { margin-top: 2px; }
  .name span { color: var(--ink-500); font-weight: 400; }

  .title {
    background: var(--kobalt-50); border: 1px solid var(--kobalt-100); border-radius: var(--radius-4);
    padding: 22px 24px; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 24px; align-items: center;
  }
  .kicker { color: var(--kobalt-700); margin-bottom: 8px; }
  h1 { font-size: 38px; font-weight: 600; letter-spacing: var(--ls-display); line-height: 1; text-wrap: balance; }
  .lede { margin-top: 12px; font-size: 14px; line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }
  .format { display: flex; flex-direction: column; gap: 8px; }
  .format li { display: flex; align-items: center; gap: 9px; line-height: 1.35; color: var(--ink-800); }
  .ic { width: 16px; height: 16px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; color: var(--kobalt-600); }

  .block, .col { display: flex; flex-direction: column; gap: 9px; }
  .label { text-transform: none; color: var(--kobalt-700); }
  .card { background: var(--abu-0); border-radius: var(--radius-3); box-shadow: var(--shadow-hairline); }
  .modules { padding: 2px 20px; }
  .module { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 14px; padding: 13px 0; border-bottom: 1px solid var(--abu-100); }
  .module:last-child { border-bottom: 0; }
  .module-num { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-family: var(--font-mono); font-size: 12.5px; font-weight: 500; }
  .module[data-tone='kobalt'] .module-num { background: var(--kobalt-50); color: var(--kobalt-700); }
  .module[data-tone='ungu'] .module-num { background: var(--ungu-50); color: var(--ungu-800); }
  .module[data-tone='langit'] .module-num { background: var(--langit-50); color: var(--langit-800); }
  .module[data-tone='mint'] .module-num { background: var(--mint-50); color: var(--mint-800); }
  .module[data-tone='amber'] .module-num { background: var(--amber-50); color: var(--amber-800); }
  .module h3 { font-size: 15px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; margin-bottom: 1px; }
  .module p { color: var(--ink-700); text-wrap: pretty; }

  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .list { display: flex; flex-direction: column; gap: 11px; }
  .list li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 10px; align-items: start; }
  .list .ic { width: 18px; height: 18px; }
  .list strong { display: block; font-weight: 600; letter-spacing: -0.01em; }
  .list span:not(.step-num) { display: block; color: var(--ink-600); line-height: 1.4; text-wrap: pretty; }
  .step-num { width: 18px; height: 18px; border-radius: 6px; background: var(--kobalt-50); color: var(--kobalt-700); font-family: var(--font-mono); font-size: 11px; font-weight: 500; display: grid; place-items: center; }
  .delivered li { display: flex; flex-direction: column; gap: 1px; padding: 9px 0; border-top: 1px solid var(--abu-200); line-height: 1.4; }
  .delivered li:first-child { padding-top: 0; border-top: 0; }
  .delivered .mono { color: var(--ink-500); }

  .foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 14px; border-top: 1px solid var(--abu-200); }
  .sig { height: 34px; width: auto; }
  .contact { color: var(--ink-700); font-size: 12px; }
</style>
