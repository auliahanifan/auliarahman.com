---
import Base from '../layouts/Base.astro';
import AppDemo from '../components/AppDemo.astro';

const heroPoints = ['Gratis untuk anggota TDA Jogja', '3 jam, maksimal 15 peserta', 'Tidak perlu bisa coding'];

const steps = [
  { title: 'Ceritakan kebutuhannya', desc: 'Dengan bahasa sehari-hari, misalnya “saya butuh kasir untuk kedai kopi, ada diskon member dan struk”.' },
  { title: 'AI membuat versi pertama', desc: 'Dalam beberapa menit muncul aplikasi yang sudah bisa diklik dan dicoba.' },
  { title: 'Coba, lalu minta perbaikan', desc: 'Cari bagian yang kurang pas, minta AI mengubahnya, dan ulangi sampai sesuai dengan cara kerja usaha Anda.' },
];

// ponytail: pola agenda sama dengan /free-training-claude; satukan kalau halaman sejenis bertambah
const agenda = [
  { time: '00.00 – 00.15', title: 'Apa itu vibe coding', form: 'Paparan dan demo', min: 15,
    result: 'Peserta melihat langsung satu aplikasi dibuat dari nol hanya dengan percakapan.' },
  { time: '00.15 – 00.35', title: 'Memilih satu kebutuhan usaha', form: 'Latihan', min: 20,
    practice: 'Tiap peserta menuliskan satu kebutuhan: siapa yang memakai aplikasinya, data apa yang dicatat, dan tampilan apa yang ingin dilihat.',
    result: 'Satu permintaan yang jelas untuk diberikan ke AI.' },
  { time: '00.35 – 01.25', title: 'Membuat versi pertama', form: 'Praktik didampingi', min: 50,
    practice: 'Peserta membuat aplikasinya sendiri di akun AI masing-masing. Saya berkeliling membantu yang tersendat.',
    result: 'Aplikasi versi pertama yang sudah bisa diklik.' },
  { time: '01.25 – 01.35', title: 'Jeda', min: 10, rest: true },
  { time: '01.35 – 02.25', title: 'Memperbaiki dan menambah fitur', form: 'Praktik didampingi', min: 50,
    practice: 'Cara meminta perubahan yang spesifik, menambah fitur satu per satu, dan apa yang dilakukan kalau muncul error.',
    result: 'Aplikasi sederhana yang lebih sesuai dengan cara kerja usaha peserta.' },
  { time: '02.25 – 02.45', title: 'Menyimpan hasil dan langkah berikutnya', form: 'Paparan dan diskusi', min: 20,
    result: 'Peserta tahu cara menyimpan aplikasinya dan apa yang perlu disiapkan sebelum dipakai sungguhan.' },
  { time: '02.45 – 03.00', title: 'Pamer hasil dan tanya jawab', form: 'Diskusi', min: 15 },
];

const bring = [
  { title: 'Laptop', desc: 'Windows atau Mac, dengan baterai penuh atau charger.' },
  { title: 'Langganan AI berbayar', desc: 'Claude, ChatGPT, atau Antigravity. Versi gratis cepat mencapai batas pemakaian saat dipakai membuat aplikasi.' },
];

const limits = [
  'Hasilnya versi awal. Cukup untuk dicoba dan dipakai sendiri atau oleh tim, tetapi perlu dirapikan sebelum dipakai pelanggan.',
  'Selama sesi, gunakan data contoh. Data pelanggan dan transaksi asli sebaiknya tidak dimasukkan dulu.',
  'Tiga jam cukup untuk satu aplikasi sederhana. Fitur seperti login banyak pengguna, pembayaran online, atau sambungan ke sistem lain butuh langkah tambahan di luar sesi.',
];

// ponytail: logo diduplikasi dari index.astro; pindah ke data bersama kalau daftar ini berubah
const logos = [
  { name: 'Noice', src: '/logos/noice.svg', h: 24 },
  { name: 'Delegasi', src: '/logos/delegasi.png', h: 28 },
  { name: 'BukuWarung', src: '/logos/bukuwarung.png', h: 40 },
  { name: 'Traveloka', src: '/logos/traveloka.png', h: 24 },
  { name: 'Alterra', src: '/logos/alterra.svg', h: 26 },
];

// Klien sengaja anonim, sama seperti di beranda.
const delivered = [
  { who: 'Perusahaan tambang dan sumber daya', how: 'Training AI · tatap muka' },
  { who: 'Tim sekretariat seorang tokoh publik', how: 'Training AI' },
  { who: 'Lebih dari 500 peserta webinar', how: 'Taalenta · Leviq' },
];
---

<Base
  title="Vibe Coding for Founders · Workshop untuk TDA Jogja"
  description="Workshop gratis 3 jam untuk anggota TDA Jogja: membuat aplikasi sederhana untuk usaha sendiri dengan bantuan AI, tanpa perlu bisa coding."
  lang="id"
  noindex
  hideNav
>
  <section class="hero-band">
    <div class="hero wrap">
      <img class="photo" src="/aulia.jpg" width="400" height="400" alt="Aulia Rahman Hanifan" fetchpriority="high" />
      <div class="mono eyebrow">Workshop gratis · Untuk anggota TDA Jogja</div>
      <h1>Vibe Coding for Founders</h1>
      <p class="lede">Workshop 3 jam untuk founder yang ingin membuat aplikasi untuk usahanya sendiri dengan bantuan AI. Peserta datang dengan satu kebutuhan, misalnya kasir sederhana atau dashboard penjualan, lalu kita buat bersama sampai aplikasinya bisa dicoba.</p>
      <div class="actions">
        <a class="btn btn-accent" href="#contoh">Coba contoh aplikasinya
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </a>
        <a class="btn btn-light" href="#agenda">Lihat agenda 3 jam</a>
      </div>
      <ul class="hero-points">
        {heroPoints.map((p) => (
          <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap how">
    <div class="sec-head">
      <div class="mono">Apa itu vibe coding</div>
      <h2>Menjelaskan aplikasi yang dibutuhkan, AI yang menulis kodenya</h2>
      <p>Peserta tidak perlu menghafal bahasa pemrograman. Yang dilatih adalah cara menjelaskan kebutuhan dengan jelas, mencoba hasilnya, dan meminta perbaikan sampai aplikasinya sesuai.</p>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="card step"><span class="mono step-num">{String(i + 1).padStart(2, '0')}</span><strong>{s.title}</strong><span>{s.desc}</span></li>
      ))}
    </ol>
  </section>

  <section id="contoh" class="demo-band">
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>
    <div class="wrap demosec">
      <div class="sec-head">
        <div class="mono">Contoh hasil</div>
        <h2>Aplikasi seperti ini yang bisa dibuat dalam sesi</h2>
        <p>Keempat contoh di bawah dibuat dengan bantuan AI dan bisa langsung dicoba, datanya fiktif. Pesan kopi lalu bayar dengan QRIS, ganti periode di dashboard, klik jam kosong di jadwal barbershop, atau geser kartu pelanggan sampai deal.</p>
      </div>
      <AppDemo />
    </div>
  </section>

  <section id="agenda" class="wrap agendasec">
    <div class="sec-head">
      <div class="mono">Agenda</div>
      <h2>Apa saja yang dikerjakan dalam 3 jam</h2>
      <p>Sebagian besar waktunya dipakai untuk praktik. Urutan dan durasinya bisa saya sesuaikan dengan acara TDA Jogja.</p>
    </div>
    <ol class="card agenda" aria-label="Agenda sesi 3 jam">
      {agenda.map((a) => (
        <li class:list={['slot', { rest: a.rest }]}>
          <span class="mono slot-time">{a.time}</span>
          <div class="slot-body">
            <div class="slot-title">
              <strong>{a.title}</strong>
              <span class="mono slot-meta">{a.form ? `${a.form} · ` : ''}{a.min} menit</span>
            </div>
            {a.practice && <p><span class="mono tag">Latihan</span>{a.practice}</p>}
            {a.result && <p><span class="mono tag">Hasil</span>{a.result}</p>}
          </div>
        </li>
      ))}
      <li class="slot total"><span class="mono slot-time">Total</span><div class="slot-body"><strong>180 menit</strong></div></li>
    </ol>
  </section>

  <section class="wrap prep">
    <div class="prep-col">
      <div class="mono">Yang perlu dibawa peserta</div>
      <ul class="bring">
        {bring.map((b) => (
          <li class="card"><strong>{b.title}</strong><span>{b.desc}</span></li>
        ))}
      </ul>
    </div>
    <div class="prep-col">
      <div class="mono">Supaya ekspektasinya pas</div>
      <ul class="limits">
        {limits.map((l) => (
          <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>{l}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap about">
    <div class="about-text">
      <div class="mono">Yang mengajar</div>
      <h2>Saya Aulia, software engineer dan founder AI Community Jogja.</h2>
      <p>Tujuh tahun membangun produk di lima startup, dua di antaranya didukung Y Combinator. Sekarang saya juga melatih tim dan komunitas memakai AI untuk pekerjaan sehari-hari, termasuk membuat aplikasi sendiri.</p>
      <ul class="logos" aria-label="Tempat saya pernah bekerja">
        {logos.map((l) => (
          <li><img src={l.src} alt={l.name} style={`height: ${l.h}px`} loading="lazy" /></li>
        ))}
      </ul>
    </div>
    <div class="delivered">
      <span class="mono">Pernah melatih</span>
      <ul>
        {delivered.map((d) => (
          <li><span>{d.who}</span><span class="mono">{d.how}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap closing">
    <div class="closing-card">
      <span class="mono">Workshop gratis · Yogyakarta</span>
      <p>Jadwal, tempat, dan format bisa menyesuaikan kegiatan TDA Jogja. Kalau cocok, kabari saya di chat WhatsApp yang sama.</p>
    </div>
  </section>
</Base>

<style>
  h1, h2 { font-weight: 600; text-wrap: balance; }
  h2 { font-size: clamp(28px, 5vw, 36px); letter-spacing: var(--ls-heading); line-height: 1.1; }
  .mono { font-size: 14px; }
  .ic { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .card { background: var(--abu-0); border-radius: var(--radius-3); box-shadow: var(--shadow-hairline); }
  .sec-head { display: flex; flex-direction: column; gap: 12px; max-width: 680px; }
  .sec-head .mono { color: var(--kobalt-700); }
  .sec-head p { font-size: 18px; line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }

  /* buttons, sama dengan beranda */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 52px; padding: 12px 22px; border-radius: var(--radius-pill);
    max-width: 100%; font-size: 17px; font-weight: 500; letter-spacing: -0.01em; text-align: center; text-wrap: balance;
    user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
    backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn:active { transform: scale(.98); }
  .btn:focus-visible { transition: none; }
  .btn-accent .ic { transition: transform var(--dur-fast) var(--ease-out); }
  .btn-accent { background: rgba(58,91,255,.95); color: #fff; border: 1px solid rgba(255,255,255,.45); box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 8px 24px rgba(58,91,255,.28); }
  .btn-light { background: rgba(255,255,255,.55); color: var(--ink-900); border: 1px solid rgba(255,255,255,.9); box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 6px 20px rgba(11,13,18,.08); }
  .btn-accent:active { color: #fff; }
  .btn-light:active { color: var(--ink-900); }
  @media (hover: hover) and (pointer: fine) {
    .btn-accent:hover { background: var(--kobalt-600); color: #fff; }
    .btn-accent:hover:not(:focus-visible) .ic { transform: translateY(3px); }
    .btn-light:hover { background: var(--abu-0); color: var(--ink-900); }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .btn-accent .ic { transition: none; }
    .btn:active, .btn-accent:hover:not(:focus-visible) .ic { transform: none; }
  }

  /* hero */
  .hero-band { background: var(--surface-hero); border-bottom: 1px solid var(--abu-200); }
  .hero { padding-top: 32px; padding-bottom: 72px; display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 48px; row-gap: 20px; align-items: start; }
  .hero > :not(.photo) { grid-column: 1; }
  .photo { grid-column: 2; grid-row: 1 / span 5; align-self: center; width: clamp(240px, 28vw, 340px); height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-4); box-shadow: var(--shadow-2); }
  h1 { font-size: clamp(40px, 6vw, 72px); letter-spacing: var(--ls-display); line-height: 1; }
  .eyebrow { color: var(--ink-500); text-wrap: balance; }
  .lede { font-size: clamp(17px, 2vw, 20px); line-height: 1.55; color: var(--ink-700); text-wrap: pretty; max-width: 620px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
  .hero-points { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 4px; }
  .hero-points li { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; color: var(--ink-700); }
  .hero-points .ic { width: 16px; height: 16px; color: var(--kobalt-600); }

  /* cara kerja */
  .how { padding-top: 72px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 28px; }
  .steps { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .step { padding: 20px 22px; display: flex; flex-direction: column; gap: 8px; border-top: 3px solid var(--kobalt-500); }
  .step-num { font-size: 13px; color: var(--kobalt-700); }
  .step strong { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; }
  .step > span:last-child { font-size: 15px; line-height: 1.5; color: var(--ink-600); text-wrap: pretty; }

  /* demo */
  /* Latar gelap dengan cahaya yang bergeser pelan; warnanya ikut aplikasi yang sedang dibuka. */
  @property --a1 { syntax: '<color>'; inherits: true; initial-value: #FFB224; }
  @property --a2 { syntax: '<color>'; inherits: true; initial-value: #FF6B47; }
  .demo-band { --a1: #FFB224; --a2: #FF6B47; --a3: #3A5BFF; position: relative; isolation: isolate; overflow: hidden; background: #07080D; color: #fff; transition: --a1 1s ease, --a2 1s ease; }
  .aurora { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .aurora i { position: absolute; width: 70vmax; height: 70vmax; border-radius: 50%; opacity: .5; will-change: transform; }
  .aurora i:nth-child(1) { top: -38vmax; left: -22vmax; background: radial-gradient(closest-side, var(--a1), transparent 72%); animation: drift-a 22s ease-in-out infinite alternate; }
  .aurora i:nth-child(2) { top: -18vmax; right: -30vmax; background: radial-gradient(closest-side, var(--a2), transparent 72%); opacity: .35; animation: drift-b 27s ease-in-out infinite alternate; }
  .aurora i:nth-child(3) { bottom: -44vmax; left: 12%; background: radial-gradient(closest-side, var(--a3), transparent 72%); opacity: .4; animation: drift-c 31s ease-in-out infinite alternate; }
  .aurora i:nth-child(4) { top: 30%; left: 40%; width: 40vmax; height: 40vmax; background: radial-gradient(closest-side, var(--a1), transparent 70%); opacity: .18; animation: drift-b 19s ease-in-out infinite alternate-reverse; }
  .aurora::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.16) 1px, transparent 1.2px); background-size: 24px 24px; mask-image: radial-gradient(ellipse 80% 60% at 50% 35%, #000 20%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 35%, #000 20%, transparent 80%); animation: dots 60s linear infinite; }
  .aurora::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, #07080D); }
  .aurora b { position: absolute; top: -50%; left: 0; width: 30%; height: 200%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.06), transparent); transform: translateX(-120%) rotate(18deg); animation: sweep 11s ease-in-out infinite; }
  @keyframes drift-a { 50% { transform: translate(18vmax, 12vmax) scale(1.15); } 100% { transform: translate(8vmax, 26vmax) scale(.95); } }
  @keyframes drift-b { 50% { transform: translate(-16vmax, 14vmax) scale(1.1); } 100% { transform: translate(-6vmax, -6vmax) scale(1.2); } }
  @keyframes drift-c { 50% { transform: translate(20vmax, -10vmax) scale(1.2); } 100% { transform: translate(-10vmax, -18vmax) scale(1); } }
  @keyframes dots { to { background-position: 0 240px; } }
  @keyframes sweep { 0%, 15% { transform: translateX(-120%) rotate(18deg); } 60%, 100% { transform: translateX(420%) rotate(18deg); } }
  @media (prefers-reduced-motion: reduce) { .aurora i, .aurora b, .aurora::before { animation: none; } }
  .demosec { padding-top: 88px; padding-bottom: 88px; display: flex; flex-direction: column; gap: 32px; }
  .demosec .sec-head .mono { color: var(--kobalt-300); }
  .demosec .sec-head h2 { color: #fff; }
  .demosec .sec-head p { color: rgba(255,255,255,.72); }

  /* agenda */
  .agendasec { padding-top: 72px; padding-bottom: 8px; display: flex; flex-direction: column; gap: 28px; }
  .agenda { list-style: none; padding: 4px 28px; box-shadow: var(--shadow-1), var(--shadow-hairline); }
  .slot { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 4px 24px; padding: 18px 0; border-bottom: 1px solid var(--abu-100); }
  .slot:last-child { border-bottom: 0; }
  .slot-time { color: var(--ink-500); font-size: 13px; padding-top: 3px; white-space: nowrap; }
  .slot-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .slot-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; }
  .slot-title strong { font-size: 17px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; }
  .slot-meta { font-size: 13px; color: var(--ink-500); }
  .slot-body p { line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }
  .tag { display: inline-block; font-size: 12px; color: var(--ink-500); margin-right: 10px; min-width: 52px; }
  .slot.rest { padding: 12px 0; }
  .slot.rest .slot-title strong, .slot.rest .slot-meta { color: var(--ink-500); font-weight: 500; }
  .slot.total .slot-time { color: var(--kobalt-700); }

  /* bawaan + batasan */
  .prep { padding-top: 56px; padding-bottom: 8px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 48px; align-items: start; }
  .prep-col { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .prep-col > .mono { color: var(--kobalt-700); }
  .bring { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .bring li { padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; }
  .bring strong { font-weight: 600; letter-spacing: -0.01em; }
  .bring span { font-size: 15px; line-height: 1.5; color: var(--ink-600); text-wrap: pretty; }
  .limits { list-style: none; display: flex; flex-direction: column; }
  .limits li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 12px; padding: 14px 0; border-top: 1px solid var(--abu-200); line-height: 1.5; color: var(--ink-700); text-wrap: pretty; }
  .limits li:first-child { border-top: 0; padding-top: 4px; }
  .limits .ic { margin-top: 1px; color: var(--amber-600); }

  /* tentang */
  .about { padding-top: 72px; padding-bottom: 56px; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .about-text { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .about-text .mono, .delivered > .mono { color: var(--kobalt-700); }
  .about-text p { font-size: 18px; line-height: 1.55; color: var(--ink-700); text-wrap: pretty; max-width: 560px; }
  .logos { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 8px; }
  .logos img { width: auto; max-width: 140px; }
  .delivered { display: flex; flex-direction: column; gap: 12px; }
  .delivered ul { list-style: none; }
  .delivered li { display: flex; flex-direction: column; gap: 2px; padding: 14px 0; border-top: 1px solid var(--abu-200); line-height: 1.4; }
  .delivered li .mono { font-size: 13px; color: var(--ink-500); }

  /* penutup */
  .closing { padding-bottom: 48px; }
  .closing-card { background: var(--ink-900); color: var(--abu-0); border-radius: var(--radius-4); padding: clamp(24px, 5vw, 44px); display: flex; flex-direction: column; gap: 12px; }
  .closing-card .mono { color: var(--abu-300); }
  .closing-card p { font-size: clamp(20px, 3vw, 28px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.3; max-width: 760px; text-wrap: pretty; }

  @media (max-width: 900px) {
    .about, .prep { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding-bottom: 56px; }
    .photo { grid-column: 1; grid-row: auto; width: 96px; border-radius: var(--radius-3); box-shadow: var(--shadow-1); }
    .how, .demosec { padding-top: 56px; padding-bottom: 56px; }
    .agendasec, .about { padding-top: 56px; }
    .steps { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .agenda { padding: 4px 18px; }
    .slot { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .slot-time { padding-top: 0; }
    .tag { display: block; margin: 0 0 2px; }
  }
  @media (max-width: 560px) {
    .lede, .about-text p, .sec-head p { font-size: 17px; }
  }
  @media (max-width: 480px) {
    .demosec { padding-left: 12px; padding-right: 12px; }
  }
  @media (max-width: 400px) {
    .actions .btn { flex: 1 1 100%; }
  }
</style>
